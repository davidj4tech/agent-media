# agent-media — machine-local config, by example.
#
# Copy to ~/.config/agent-media.env and keep only the lines you mean. Every key
# here is optional: unset means the default, and a host that sets nothing at all
# still works. This is the file every hook invocation and the `media` CLI read,
# so it is the one place where "what this machine does" is written down.
#
#   cp agent-media.env.example ~/.config/agent-media.env
#   media-setup check && media-setup status
#   media doctor
#
# WHERE THIS SITS
#
# Config is layered, and each layer only fills what is still unset:
#
#   1. real environment variables          (a shell export wins over everything)
#   2. $MEDIA_ENV_FILE                     (explicit override)
#   3. ~/.config/agent-media.env           (this file — the machine)
#   4. packages/core/.../defaults.env      (shipped, host-agnostic, LOWEST)
#
# So there is already a defaults file: read `defaults.env` in the core package
# to see what a host with no config at all does. Only put MACHINE-SPECIFIC
# things here — routing, sinks, targets, latencies. Anything host-agnostic
# belongs in defaults.env so every machine gets it.
#
# THREE THINGS ABOUT THE FORMAT
#
#   * The parser takes EVERYTHING after the first `=`. An inline comment is not
#     a comment, it is part of the value — `MEDIA_RENDER_ENGINE=edge  # nice`
#     asks for an engine called "edge  # nice". Put comments on their own line.
#   * An EMPTY value reads as unset and gets backfilled from the layer below.
#     To switch something off, give it `-`, which becomes an empty string that
#     stays empty: `MEDIA_REMOTE_SAY_CMD=- media say "renders here instead"`.
#   * Real environment variables win over this file.
#
# WHAT IS NOT HERE
#
#   * Secrets. Tokens and API keys live beside the thing that needs them —
#     Audiobookshelf's in ~/.config/agent-media/abs-bridge.env, the gateway's in
#     ~/.config/litellm/litellm.env.
#   * Host roles (origin / render / observe) and per-feed settings, which are in
#     ~/.config/agent-media/config.toml, not here.
#   * The long tail. There are ~320 MEDIA_* keys; these are the ones a host is
#     actually set up with. Each package README documents its own in full —
#     packages/visual/README.md, packages/core/README.md, and so on.
#   * Anything defaults.env already sets sensibly. The few repeated below are
#     there because a host usually wants to change them.


# --- where the checkout lives -------------------------------------------------
# Only needed if the repo is somewhere other than ~/agent-media. Read by the
# dotfiles installer so it updates this checkout instead of cloning a second
# one; the services bake their own path in at install time.
#AGENT_MEDIA_DIR=/home/you/projects/agent-media


# --- speech: where a spoken reply comes out -----------------------------------
# local  — this machine's mpv (default)
# rooms  — the Snapcast lane, heard wherever an unmuted snapclient is
# phone  — the phone's own mpv over a tcp bridge
#MEDIA_SPEECH_DEFAULT_TARGET=local

# mpv's audio output. The default (openal) cannot open a device on a PipeWire
# host, and a service started by runit has no XDG_RUNTIME_DIR to find pulse
# through — both fail by playing silence while reporting health, so set it
# explicitly on a desktop host.
#MEDIA_SPEECH_AO=pipewire

# Rewrite a long reply into speakable prose before rendering it (describes code
# and tables, drops URLs) instead of reading stripped markdown aloud. Needs the
# summary model below.
#MEDIA_SPEECH_SUMMARY=1

# For a remote target, the bridge and the mpv on the other end. Suffix any
# speech key with the target name to set it per-target.
#MEDIA_SPEECH_SOCKET_PHONE=tcp://phone:6600
#MEDIA_SPEECH_DEVICE_PHONE=phone


# --- rendering the words ------------------------------------------------------
# Engine (entry-point group agent_media.engines): edge (the default — it needs
# no API key), kokoro, openai, qwen, realtime.
#MEDIA_RENDER_ENGINE=edge
# Tried when the primary fails — edge occasionally 503s mid-reply and drops
# sentences, which is worse than being slow.
#MEDIA_RENDER_FALLBACK_ENGINE=openai
# Voices are per-engine, so several can be set at once and the voice always
# matches whichever engine renders. defaults.env picks one per engine already
# (edge: en-AU-NatashaNeural).
#MEDIA_RENDER_VOICE_EDGE=en-AU-WilliamNeural
#MEDIA_RENDER_VOICE_OPENAI=onyx
#MEDIA_RENDER_VOICE_KOKORO=af_heart


# --- the summary model --------------------------------------------------------
# Its own base URL and key so it does not hijack the OpenAI TTS fallback above.
# A local gateway keeps replies on the box, and small-and-fast beats good here:
# this runs in front of speech. Default model is gpt-4o-mini.
#MEDIA_SUMMARY_BASE_URL=http://127.0.0.1:4000/v1
#MEDIA_SUMMARY_KEY_FILE=/home/you/.config/litellm/key
#MEDIA_SUMMARY_MODEL=llama-3.2-3b


# --- music and audiobooks -----------------------------------------------------
# Same target vocabulary as speech. An unset book target means an untargeted
# `media book play` uses the code default, which may not be this machine.
#MEDIA_MUSIC_DEFAULT_TARGET=rooms
#MEDIA_BOOK_DEFAULT_TARGET=rooms
# Duck the phone's local music under speech.
#MEDIA_MUSIC_LOCAL_ENDPOINT=http://phone:8770


# --- the visual canvas --------------------------------------------------------
# Illustrate spoken replies on the wall/phone canvas.
#MEDIA_SPEECH_VISUAL=1
# Only illustrate replies at least this long (default 320).
#MEDIA_VISUAL_MIN_CHARS=320
# Where the canvas listens. The service passes --bind <tailscale-ip> itself.
#MEDIA_VISUAL_PORT=8781
# Canvases to push to — comma-separated for several. With more than one, images
# are referenced by the FIRST target's absolute URL, so make that the tailnet
# one, reachable from every screen.
#MEDIA_VISUAL_URL=http://100.64.0.1:8781,http://phone:8781
#MEDIA_VISUAL_ENGINE=venice


# --- replying from the Audiobookshelf player ----------------------------------
# The canvas answers the app on /conversation, /conversation/log, /item and
# /reply, authorised by the caller's own Audiobookshelf login. Typing into a
# session is a capability ABS has no permission for, so it is named here.
#MEDIA_REPLY_USERS=david,sam
# Root is allowed by default; 0 stops that.
#MEDIA_REPLY_ROOT=0
# tmux session to open revived windows in (default: the attached client's).
#MEDIA_REPLY_TMUX=p-agent-media
# Other Audiobookshelf servers whose logins to accept — a bearer means nothing
# to the server that did not issue it, so a second server (trying a new client,
# say) has to be named or its users are told their login was rejected. Use an
# address the CANVAS HOST can reach: a container published on a tailnet IP is
# not on loopback. Also settable as ABS_URLS in abs-bridge.env.
#MEDIA_ABS_URLS=http://100.64.0.1:13379


# --- call guard ---------------------------------------------------------------
# Pause or duck playback while a call is up.
#MEDIA_CALL_GUARD_SOCKETS=/run/user/1000/mpv-speech.sock
#MEDIA_CALL_GUARD_DUCK_SOCKETS=/run/user/1000/mpv-music.sock
#MEDIA_CALL_GUARD_HOLD_FLAG=/run/user/1000/agent-media/hold


# --- the podcast feed ---------------------------------------------------------
# Off by default, and deliberately: the enclosures are recordings of private
# conversations. Off loopback the token is not optional and the server refuses
# to start without it.
#MEDIA_FEED_BASE_URL=http://100.64.0.1:8782
#MEDIA_FEED_BIND=100.64.0.1
#MEDIA_FEED_TOKEN=
#MEDIA_FEED_PORT=8782


# --- the tmux status line -----------------------------------------------------
#MEDIA_STATUS_NOW_PLAYING_MIN=18
#MEDIA_STATUS_NOW_PLAYING_MAX=46
# Do not reach across the network to build the status line (a laptop that is
# often away from the tailnet).
#MEDIA_STATUS_NO_REMOTE=1
