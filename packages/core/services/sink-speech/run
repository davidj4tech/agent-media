#!/data/data/com.termux/files/usr/bin/sh
# Speech sink: long-running mpv broker for TTS playback.
# Socket: $XDG_STATE_HOME/agent-media/sink-speech.sock
#
# AO prefers pulse when a sound server is actually answering, else openal —
# which survives BT route changes on Termux (2026-05-14). On a PipeWire/Pulse
# host pulse is also what makes per-clip `audio-device=pulse/<sink>` routing
# (decision 1C) work; the openal AO doesn't understand pulse device ids.
#
# The probe exists because the openal/opensles AOs open the Android audio
# device DIRECTLY, and the device only hands out so many engines. The phone
# runs five idle mpv brokers (speech, book, music, voice, generic) beside up to
# three snapclients, and once they have taken the engines between them every
# later open fails with a bare "could not open device" — mpv then drops the
# file and exits 0, so say.sh reports CLIP/DURATION and the reply is simply
# never heard. Nothing upstream can tell that apart from success. Silent since
# ~2026-08-09 09:17 on p8a; found 2026-08-10.
#
# pulseaudio holds ONE engine and mixes every client into it, so routing the
# brokers through it removes the contention entirely rather than racing for a
# scarce resource. Probe rather than hardcode: `pactl info` answering is the
# only reliable evidence a server is up, and if it isn't, openal direct is
# still the best available fallback.
exec 2>&1
if [ -z "${MEDIA_SPEECH_AO:-}" ]; then
  if command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1; then
    MEDIA_SPEECH_AO=pulse
  else
    MEDIA_SPEECH_AO=openal
  fi
fi
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agent-media"
SOCK="$STATE/sink-speech.sock"
mkdir -p "$STATE"
rm -f "$SOCK"
# Keep scaletempo2 permanently in the filter chain. mpv otherwise AUTO-inserts
# it the moment speed leaves 1.0× and REMOVES it when speed returns to 1.0× —
# and each insert/remove rebuilds the filter graph, which tears down and
# re-inits the audio output. The openal AO (the Termux default) handles that
# reinit badly: it underruns and restarts, heard as playback briefly "stopping"
# every time the speed crosses 1.0×. Verified on the phone: 4 crossings → 4
# underruns baseline, 0 with scaletempo2 pinned.
#
# Pitch correction must stay ON. `audio-pitch-correction=no` does NOT merely
# suppress a second auto-inserted scaletempo2 (the old comment here claimed
# that) — it makes mpv apply speed by RESAMPLING and never hand the speed to
# any scaletempo2, pinned or not, so speech chipmunks. Measured on mpv 0.40 with
# a 200 Hz tone at 1.5×: `=no` → 300 Hz (+7 semitones), `=yes` → 201 Hz. With
# `=yes` mpv reuses the pinned filter rather than inserting its own (verified:
# `af` reports one scaletempo2, and four crossings of 1.0× via IPC produced no
# AO reinit), so the underrun fix above still holds.
#
# Belt-and-suspenders: pin one output format so a clip whose native rate/
# channels differ from the previous one can't force the same AO reinit at a
# boundary. 48 kHz / s16 / stereo is the devices' native format here, so this
# never makes the *device* itself resample. All overridable per host.
: "${MEDIA_SPEECH_SAMPLERATE:=48000}"
: "${MEDIA_SPEECH_FORMAT:=s16}"
: "${MEDIA_SPEECH_CHANNELS:=stereo}"
# Louder default. --volume is mpv's *software* gain; 100 is nominal, so to go
# above it we also lift --volume-max (mpv clamps --volume to it). Amplifying
# past 100 risks clipping on already-hot clips — that's exactly what the
# loudness filter below guards against by normalizing peaks. Both overridable.
: "${MEDIA_SPEECH_VOLUME:=150}"
: "${MEDIA_SPEECH_VOLUME_MAX:=200}"
# Per-stream loudness normalization (EBU R128-ish). Each channel is its own
# mpv/Mopidy, so we can't read the music's live level — but pulling every
# stream toward one target loudness makes speech sit at the same perceived
# level as the music instead of booming or vanishing under it. dynaudnorm is
# frame-based (works on short TTS clips with no two-pass/startup lag, unlike
# loudnorm). Set MEDIA_SPEECH_LOUDNORM= (empty) to disable.
# maxgain is the real ceiling on *quiet* clips: dynaudnorm won't amplify a
# frame beyond it even to reach targetrms, so a low maxgain leaves quiet TTS
# quiet no matter how high --volume goes. Raised to 30 so soft clips actually
# reach the target loudness; targetrms=0.95 pushes the resting level up too.
: "${MEDIA_SPEECH_LOUDNORM:=dynaudnorm=targetrms=0.95:maxgain=30:gausssize=15}"
AF="scaletempo2"
[ -n "$MEDIA_SPEECH_LOUDNORM" ] && AF="$AF,$MEDIA_SPEECH_LOUDNORM"
exec mpv --idle=yes --ao="$MEDIA_SPEECH_AO" --force-window=no \
  --input-ipc-server="$SOCK" \
  --volume-max="$MEDIA_SPEECH_VOLUME_MAX" --volume="$MEDIA_SPEECH_VOLUME" \
  --keep-open=no \
  --gapless-audio=no --audio-stream-silence=no --ytdl=no \
  --network-timeout=60 \
  --af="$AF" --audio-pitch-correction="${MEDIA_SPEECH_PITCH_CORRECTION:-yes}" \
  --audio-samplerate="$MEDIA_SPEECH_SAMPLERATE" \
  --audio-format="$MEDIA_SPEECH_FORMAT" \
  --audio-channels="$MEDIA_SPEECH_CHANNELS"
