[Unit]
Description=Audiobookshelf (React client) — the sasonica-web test bed
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=audiobookshelf-react
Image=ghcr.io/audiobookshelf/audiobookshelf-react:latest
# Tailnet only: this is a second server for trying the new client against,
# not a published one. The primary on 13378 is the real one.
PublishPort=100.103.43.93:13379:80
# Its own config and metadata — a separate database from the primary's, so
# the two never share a sqlite file.
Volume=%h/.local/share/audiobookshelf-react/config:/config
Volume=%h/.local/share/audiobookshelf-react/metadata:/metadata
# The libraries read-only: this instance is a client test bed and has no
# business writing to them. `media abs-scan` fans metadata out to it (see
# ABS_SERVERS in ~/.config/agent-media/abs-bridge.env) because its own file
# watcher is off.
Volume=%h/conversations:/conversations:ro
Volume=%h/audiobooks:/audiobooks:ro

# --- the fork -----------------------------------------------------------------
# sasonica-web (davidj4tech/sasonica-web, branch `sasonica`) is our fork of the
# React client, and these mount its build over the image's.
#
# The BUILD OUTPUT only, never the whole checkout: this image is Alpine/musl
# and red5's node_modules are built against glibc, so mounting the checkout
# puts the wrong libc's @next/swc and @parcel/watcher in front of the server
# and it refuses to start ("Error loading shared library ld-linux-x86-64.so.2").
# The image's own node_modules are the right ones, and our package.json adds
# no dependencies, so only these four need to cross.
#
# Redeploy = `pnpm build` in the checkout, then restart this unit: Next reads
# .next at startup. To go back to stock, comment these four out and restart.
Volume=%h/projects/sasonica-web/.next:/app/client-react/.next
Volume=%h/projects/sasonica-web/public:/app/client-react/public:ro
Volume=%h/projects/sasonica-web/next.config.ts:/app/client-react/next.config.ts:ro
Volume=%h/projects/sasonica-web/package.json:/app/client-react/package.json:ro

Environment=TZ=Australia/Melbourne
Environment=PORT=80
Environment=METADATA_PATH=/metadata
Environment=CONFIG_PATH=/config

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
