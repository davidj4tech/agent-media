#!/usr/bin/env bash
# Full-size fzf clip browser for the speech channel (popup `c`).
# Opens on THIS conversation's clips, newest first; ctrl-a widens to every
# conversation in the order they were played (rows grow a ▪window label so
# interleaved conversations stay tellable-apart); ctrl-s narrows back.
# Enter replays the selection.
set -u
N=500
sess_cmd="media history $N --session --lines"
all_cmd="media history $N --lines"

err="${TMPDIR:-/tmp}/media-popup-clips.err.$$"
trap 'rm -f "$err"' EXIT

# Build the first view before fzf so backend failures stay visible here.
lines=$($sess_cmd 2>"$err")
if [ $? -ne 0 ] || [ -z "$lines" ]; then
    cat "$err" >&2
    echo "no clips recorded for this conversation" >&2
    echo
    read -r -p "enter to close" _
    exit 1
fi

sel=$(printf '%s\n' "$lines" \
    | fzf --with-nth=1 --delimiter=$'\t' --prompt='clips> ' \
          --header='enter replay · ^a all convos (played order) · ^s this convo' \
          --bind "ctrl-a:reload($all_cmd)+change-prompt(clips·all> )" \
          --bind "ctrl-s:reload($sess_cmd)+change-prompt(clips> )")
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
[ -n "$sel" ] || exit 1

media replay --id "${sel#*$'\t'}"
