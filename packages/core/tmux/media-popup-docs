#!/usr/bin/env bash
# Full-size fzf document browser (popup `d`).
# Lists everything under the doc roots — title, date, kind, status — newest
# dated first, reference after. Enter renders (cached) and plays it on the
# book channel, so chapters, resume position and speed all work on it the way
# they do for an audiobook. A document is a short audiobook.
#
# First play of a long document is tens of seconds of synthesis, so say so:
# otherwise the popup closes and nothing appears to happen.
set -u
list_cmd="media doc list --lines"

err="${TMPDIR:-/tmp}/media-popup-docs.err.$$"
trap 'rm -f "$err"' EXIT

# Build the view before fzf so a backend failure stays visible here rather
# than becoming an empty picker.
lines=$($list_cmd 2>"$err")
if [ $? -ne 0 ] || [ -z "$lines" ]; then
    cat "$err" >&2
    echo "no documents found (set MEDIA_DOC_ROOTS to add more)" >&2
    echo
    read -r -p "enter to close" _
    exit 1
fi

sel=$(printf '%s\n' "$lines" \
    | fzf --with-nth=1 --delimiter=$'\t' --prompt='docs> ' \
          --header='enter listen (renders on first play) · esc cancel')
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
[ -n "$sel" ] || exit 1

slug=${sel#*$'\t'}
[ -n "$slug" ] || exit 1

printf 'rendering %s ...\n' "$slug"
media doc play "$slug"
