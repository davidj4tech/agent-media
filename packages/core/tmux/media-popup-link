#!/usr/bin/env bash
# --- read-whole-file guard -------------------------------------------------
# Everything below lives in one brace group, and that is load-bearing.
#
# bash reads a script lazily, from a byte offset in the open file. Edit the
# file while an instance is running and that instance resumes at the old
# offset in the new text — mid-token, mid-function — and starts executing
# whatever happens to be there. For a long-lived popup the visible result is a
# UI whose keys do arbitrary things, including the key that closes it: on
# 2026-08-09 an edit to this file left a popup that could not be quit and cost
# a whole tmux session.
#
# A compound command must be parsed in full before any of it runs, so wrapping
# the body forces bash to read the entire file up front. After that, editing
# the file cannot affect a running copy at all.
{
# A web-UI URL shown in its own popup, sized by media-popup-open to the FULL
# client width (the main control popup is capped at ~34 cols, too narrow for a
# long URL). The URL is an OSC 8 hyperlink, so capable terminals open it on the
# attached client; Termux falls back to long-pressing the plain text. The URL is
# also copied to the tmux paste buffer. URL via $MEDIA_POPUP_LINK. Any key closes.
set -u
url="${MEDIA_POPUP_LINK:-}"
printf '\033[?25l'                                   # hide cursor
trap 'printf "\033[?25h"' EXIT
[ -n "$url" ] && tmux set-buffer -- "$url" 2>/dev/null
printf '\033[H\033[2J'
# Row 1: a short hint (kept brief so it never wraps and pushes the URL down).
# Row 2+: the URL as one OSC 8 hyperlink (also plain text for Termux long-press).
# Wrap stays on so a URL wider than even the full client wraps (into the popup's
# spare row) rather than clipping.
printf ' ↗ open on this client:\r\n \033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$url"
IFS= read -rsn1 _
exit $?
}
