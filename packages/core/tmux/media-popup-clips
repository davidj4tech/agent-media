#!/usr/bin/env bash
# --- read-whole-file guard -------------------------------------------------
# Everything below lives in one brace group, and that is load-bearing.
#
# bash reads a script lazily, from a byte offset in the open file. Edit the
# file while an instance is running and that instance resumes at the old
# offset in the new text — mid-token, mid-function — and starts executing
# whatever happens to be there. For a long-lived popup the visible result is a
# UI whose keys do arbitrary things, including the key that closes it: on
# 2026-08-09 an edit to this file left a popup that could not be quit and cost
# a whole tmux session.
#
# A compound command must be parsed in full before any of it runs, so wrapping
# the body forces bash to read the entire file up front. After that, editing
# the file cannot affect a running copy at all.
{
# Full-size fzf clip browser for the speech channel (popup `c`).
# Opens on THIS conversation's clips, newest first; ctrl-a widens to every
# conversation, grouped choose-tree style (▪window header per conversation,
# clips indented beneath — headers aren't acceptable, Enter on one is a
# no-op); ctrl-s narrows back. Enter on a clip replays it.
set -u
N=500
sess_cmd="media history $N --session --lines"
all_cmd="media history $N --lines --group"

err="${TMPDIR:-/tmp}/media-popup-clips.err.$$"
trap 'rm -f "$err"' EXIT

# Build the first view before fzf so backend failures stay visible here.
lines=$($sess_cmd 2>"$err")
if [ $? -ne 0 ] || [ -z "$lines" ]; then
    cat "$err" >&2
    echo "no clips recorded for this conversation" >&2
    echo
    read -r -p "enter to close" _
    exit 1
fi

# Group headers carry no TAB/history-id field; only rows with one may accept.
# (single-quoted grep pattern holds a literal tab)
tab_guard="printf %s {} | grep -q '	' && echo accept || echo ignore"

sel=$(printf '%s\n' "$lines" \
    | fzf --with-nth=1 --delimiter=$'\t' --prompt='clips> ' \
          --header='enter replay · ^a all convos (grouped) · ^s this convo' \
          --bind "enter:transform:$tab_guard" \
          --bind "ctrl-a:reload($all_cmd)+change-prompt(clips·all> )" \
          --bind "ctrl-s:reload($sess_cmd)+change-prompt(clips> )")
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
[ -n "$sel" ] || exit 1

# Belt-and-braces: never hand a header line (no TAB) to replay.
case "$sel" in
    *$'\t'*) media replay --id "${sel#*$'\t'}" ;;
esac
exit $?
}
