#!/usr/bin/env python3
"""Publish calendar availability and always record a success/failure alert."""
import argparse
import json
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument("--config", default="")
args = parser.parse_args()
ok = False
conflicts = 0
try:
    done = subprocess.run(["media", "calendar", "publish", "--publish-config", args.config],
                          text=True, capture_output=True, timeout=260)
    result = json.loads(done.stdout) if done.returncode == 0 else {}
    ok = result.get("ok") is True
    conflicts = int(result.get("booking_conflicts", 0))
except Exception:
    pass
subprocess.run(["agent-alert", "report", "calendar.availability-sync", "--level", "warn" if ok and conflicts else "ok" if ok else "needs",
                "--title", "Calendar conflicts need review" if ok and conflicts else "Booking calendar sync healthy" if ok else "Booking calendar sync failed",
                "--detail", f"{conflicts} existing bookings conflict with calendar holds; no bookings moved." if ok and conflicts else "Timing-only availability published." if ok else
                "Last verified snapshot retained. New slots close if the snapshot is older than two hours.",
                "--every", "600"], timeout=20, check=False)
print("Calendar availability published" if ok else "Calendar availability sync failed")
raise SystemExit(0 if ok else 1)
