#!/usr/bin/env bash
# Roll the canvas onto every screen that serves one.
#
# The page is assembled at import and served from memory, so a commit changes
# nothing anywhere until each canvas is restarted -- and there is more than one
# canvas. red5 runs the wall's (systemd user unit); the phone runs its own
# local control surface (runit, loopback-bound) out of its own checkout.
#
# This exists because doing it by hand is doing it from memory, and memory is
# what failed: after a run of canvas fixes the phone's copy was left two
# versions behind, so every report of "it's still not happening" was TRUE on
# the screen being looked at and false on the one being tested. Six rounds of
# that. A deploy that covers one host is worse than no deploy, because it
# looks like it worked.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/../../.." && pwd)"
PHONE="${MEDIA_CANVAS_PHONE:-p8a}"

cd "$HERE"
if [ -n "$(git status --porcelain -- packages/visual packages/server)" ]; then
    echo "packages/visual or packages/server has uncommitted changes -- commit before deploying." >&2
    exit 1
fi
git push -q origin main 2>/dev/null || true

# The canvas imports packages that live beside it (packages/server since the
# split of 21 Sep 2026). A pull that adds one leaves an editable install that
# cannot import it, and a restart then takes the canvas down. So: install
# what is missing, then prove the canvas imports BEFORE stopping the one
# that is running — a failed deploy should leave the old canvas up.
PKGS="server visual"

echo "== red5 =="
for pkg in $PKGS; do
    mod="agent_media_$pkg"
    .venv/bin/python -c "import $mod" 2>/dev/null \
        || { echo "  installing packages/$pkg"; .venv/bin/pip install -q -e "packages/$pkg"; }
done
.venv/bin/python -c 'import agent_media_visual.canvas' \
    || { echo "red5: the canvas does not import -- not restarting it" >&2; exit 1; }
systemctl --user restart agent-media-visual-canvas
sleep 2
red5_id="$(curl -s -m 8 http://red5:8781/pageid || echo unreachable)"
echo "  serving $red5_id"

echo "== $PHONE =="
# shellcheck disable=SC2029  # $PREFIX is meant to expand on the phone
# The phone's venv was built by uv and has no pip; --no-deps so nothing
# native is rebuilt there (see termux-python-heal.sh).
ssh "$PHONE" "cd ~/projects/agent-media && git pull -q --ff-only
for pkg in $PKGS; do
    .venv/bin/python -c \"import agent_media_\$pkg\" 2>/dev/null || {
        echo \"  installing packages/\$pkg\"
        uv pip install -q --no-deps --python .venv/bin/python -e packages/\$pkg; }
done
.venv/bin/python -c 'import agent_media_visual.canvas' \\
    || { echo '$PHONE: the canvas does not import -- not restarting it' >&2; exit 1; }"
ssh "$PHONE" 'SVDIR=$PREFIX/var/service sv restart canvas-local >/dev/null
sleep 2
printf "  serving "; curl -s -m 6 http://127.0.0.1:8781/pageid'

phone_id="$(ssh "$PHONE" 'curl -s -m 6 http://127.0.0.1:8781/pageid' || echo unreachable)"
if [ "$red5_id" != "$phone_id" ]; then
    echo "MISMATCH: red5=$red5_id $PHONE=$phone_id" >&2
    exit 1
fi
echo "both on $red5_id"

# media-sessiond owns running headless chats, so a deploy never restarts it
# (that would cut a reply off mid-turn). Say when it is older than the code
# just deployed, so the restart is a choice rather than a surprise.
if systemctl --user is-active --quiet agent-media-sessiond 2>/dev/null; then
    started="$(systemctl --user show -p ActiveEnterTimestamp --value agent-media-sessiond)"
    started_s="$(date -d "$started" +%s 2>/dev/null || echo 0)"
    code_s="$(git log -1 --format=%ct -- packages/server packages/core)"
    if [ "$started_s" -lt "$code_s" ]; then
        echo "note: media-sessiond predates this code -- restart it when no headless chat is mid-reply:"
        echo "      systemctl --user restart agent-media-sessiond"
    fi
fi
