#!/usr/bin/env bash
# Full keymap for the agent-media control popup, shown in a nested popup from
# the main popup's `?` key. Renders the key reference, waits for any key, exits.
# Kept narrow (<=22 cols) so it fits a ~26-col phone client.
set -u
printf '\033[?25l'                       # hide cursor
cleanup() { printf '\033[?25h'; }        # restore on exit
trap cleanup EXIT
cat <<'EOF'
 agent-media popup
 — any channel —
 Tab  next channel
 Spc  play / pause
 h l  seek -/+5s
 H L  seek -/+30s
 - =  volume -/+5
 < >  prev / next
 g    go to source
 q    close
 — speech —
 r  replay last
 p  clip at cursor
 m  mute
 v  highlight
 — speech & book —
 [ ]  speed -/+
 0    reset speed

 (press any key)
EOF
IFS= read -rsn1 _
