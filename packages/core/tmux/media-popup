#!/usr/bin/env bash
# Interactive agent-media control popup — runs inside `tmux display-popup -E`.
# A compact two-line overlay: line 1 is a marquee (the title of the pane that
# produced the now-playing speech; the current track on the music channel),
# line 2 is the live clock. Tab cycles channels; single-key hotkeys drive the
# `media` CLI and route to the active channel:
#
#   Tab     switch channel (speech ⇆ music ⇆ book)
#   Space   play/pause toggle          r   replay latest clip   (speech)
#   p       play clip at copy-mode cursor (speech) — the spoken clip whose
#           text sits at/above the cursor; no copy-mode → this pane's latest
#   h / l   prev/next sentence         H / L   prev/next paragraph
#           (speech; ±5s/±30s seek on music & book)
#   - / =   volume -5 / +5             m   mute now (momentary)   (speech/music)
#   M       keep muted — durable mute of the popup subject (the pane shown in
#           the title: ↪ = another pane). Still recorded for replay, never
#           plays live or ducks. 🔒 in the title = subject muted; 🔒N indicator
#           = N muted in total.                                          (speech)
#   [ / ]   slower / faster (accel)    ⌫   reset speed (0 also works)           (speech/book)
#   < / >   older/newer — speech: turn · music: track · book: part.
#           < is ⏮: restarts the current item first if you're past its start
#           (grace = MEDIA_POPUP_PREV_RESTART_S, def 3s), else steps back.
#   o       open a URL on this channel — music (ducks) / book (pauses);
#           pre-fills from the tmux paste buffer, so copy a link then o, Enter
#   w       the channel's web UI — music → Mopidy-Iris, book → simple-mpv-webui.
#           mel can't open the client's browser, so it shows the URL as a
#           tappable link (+ raw URL + copies it to the tmux paste buffer)
#   v       toggle auto-highlight (speech)   ?  help   q / Esc  close
#   ← →     (or ↑ ↓) move a focus highlight across the buttons; Enter activates
#           the focused one; Esc clears the highlight (then Esc again quits).
#           Purely optional — Space stays play/pause and every hotkey is direct.
#
# Mouse (SGR 1006): clickable regions are laid out across both rows —
#   row 1: channel glyph (top-left) switches channel · title jumps to source ·
#          'x' (top-right) closes
#   row 2: '<' prev · the progress core is play/pause · '>' next · '-'/'+' vol
#   The scroll wheel nudges volume. On the music and book channels the marquee
#   title is also an OSC 8 hyperlink — a Ctrl/Cmd-click opens the track's
#   source URL in the terminal's browser.
#
# Caller pane for `v`/the speech marquee comes from TTS_POPUP_PANE (set by
# the tmux binding).
set -u
MEDIA="${MEDIA:-media}"
# Mouse-event debug log (calibration aid). Prefer the env (forwarded by the
# launcher), else read it straight from tmux's global environment so
# `tmux setenv -g MEDIA_POPUP_DEBUG <file>` works even though run-shell jobs
# don't reliably inherit it.
[ -z "${MEDIA_POPUP_DEBUG:-}" ] && \
    MEDIA_POPUP_DEBUG=$(tmux show-environment -g MEDIA_POPUP_DEBUG 2>/dev/null \
        | sed -n 's/^MEDIA_POPUP_DEBUG=//p')
# Caller pane for the `v` show-text. Prefer the binding's TTS_POPUP_PANE,
# but fall back to asking tmux directly — inside a display-popup the
# attached session's active pane *is* the caller, so the highlight works
# even when the env hop didn't carry (the old popup's failure mode).
HL_PANE="${TTS_POPUP_PANE:-}"
case "$HL_PANE" in *'#{'*) HL_PANE="" ;; esac
[ -z "$HL_PANE" ] && {
    _sess=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    [ -n "$_sess" ] && HL_PANE=$(tmux display-message -p -t "$_sess:" '#{pane_id}' 2>/dev/null || true)
}
# Export so child processes (`media replay`, `media replay-track`) see the
# resolved pane id rather than the literal '#{pane_id}' that some tmux
# versions leave unexpanded.
export TTS_POPUP_PANE="$HL_PANE"

speed=1.0
bspeed=1.0              # book channel speed (tracked separately from speech)
# Speed [ / ] ladder: at/above 1.0x, presses hop the rungs (1.0 1.5 2.0 3.0 —
# widening gaps, so a held key accelerates); below 1.0x, fine flat 0.1 steps.
SPEED_RUNGS="1.0 1.5 2.0 3.0"
hist_idx=1
# Fused speech keys: instead of running `$MEDIA <verb>` and then a separate
# `popup-status` redraw (two Python spawns per press), a fusable speech key
# stashes its verb here; the loop hands it to `fetch` which runs the action AND
# returns the redraw in ONE spawn (`popup-status --act …`). ACT_OUT holds that
# action's stdout (e.g. replay-prev's resolved history cursor).
SPEECH_ACT=()
ACT_OUT=""
CHANNEL="${MEDIA_POPUP_CHANNEL:-speech}"   # speech | music | book (Tab cycles); the
                        # launcher restores it across a `?` help round-trip
BOOK_SOCK="${MEDIA_BOOK_SOCKET:-$HOME/.local/state/agent-media/sink-book.sock}"
SPEECH_SOCK="${MEDIA_SPEECH_SOCKET:-$HOME/.local/state/agent-media/sink-speech.sock}"
# Indicator state (line-2 cluster). Read fresh from the active channel's socket
# each fetch so they're honest regardless of who changed them.
MUTED=""        # 1 when the active channel is muted
SPD=""          # active channel's actual speed ("" / "1" → hidden)
PART=""         # "2/5" when a multi-part book/playlist is active
LOADING=""      # 1 while the book channel is resolving a load (YouTube gap)
IDLE=""         # 1 when the book channel has a queued-but-unstarted entry
SPIN=0          # spinner frame index (advances each draw while LOADING)
SPIN_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
HL=""           # speech auto-highlight: on|off (tracked from the v key)
# The pause-action glyph for the play/pause button: ‖ (U+2016 DOUBLE VERTICAL
# LINE). NOT ⏸ (U+23F8), which is Emoji_Presentation=Yes — phone fonts render
# that as a colored (orange) emoji and ignore a VS15 text selector. ‖ is plain
# text (Emoji=No), always black-and-white, and single-column like ▶ → no drift.
PAUSE_GLYPH='‖'
VOL_SHOW=0      # ticks remaining to show the transient volume readout
VOL_TXT=""      # the transient volume readout text
VOL_TICKS=8     # ~1.6s at TICK=0.2

# Cached snapshot of the CLI state. The draw loop ticks fast (TICK) so the
# marquee scrolls smoothly, but the `media` CLI costs ~150ms/call, so we
# only refresh this snapshot every FETCH_EVERY ticks (~1s) — and right after
# a keypress so actions feel instant.
LABEL="agent-media"     # marquee text (pane title / current track)
LINK=""                 # http(s) source URL for the current track (music/book);
                        # wraps the marquee in an OSC 8 hyperlink when set
STATUS=""               # second line: progress bar for the active channel
MCOUNT=""               # durable-mute badge count (speech); "" hides it

# Marquee state. When LABEL is wider than the line, draw() scrolls it once
# (a single left-to-right pass), holding briefly at each end, then parks at
# the start (SCROLL_DONE) and stays put until LABEL changes.
LAST_LABEL=""
SCROLL_OFFSET=0
SCROLL_HOLD_TICKS=6
SCROLL_HOLD_COUNT=0
SCROLL_DONE=0

# SGR mouse reporting (1006) lets the popup hit-test clicks on the button row
# and the title. Toggle it off around the blocking text prompts (typed_seek /
# typed_open / confirm) so a stray click can't inject escape bytes into a typed
# line.
mouse_on()  { printf '\033[?1000h\033[?1006h'; }
mouse_off() { printf '\033[?1000l\033[?1006l'; }

# The popup tty runs raw (-echo -icanon, set below) so single keys arrive
# instantly and mouse bytes don't echo. The typed prompts (typed_seek /
# typed_open) need the opposite — echo so you can see what you type, icanon so
# backspace edits the line — so they flip to line mode for the read and back.
tty_line() { stty echo icanon 2>/dev/null || true; }
tty_raw()  { stty -echo -icanon min 1 time 0 2>/dev/null || true; }

# Put the tty in raw, no-echo mode for the popup's whole lifetime. Without this
# the terminal only suppresses echo *during* each `read -s`; mouse-report bytes
# that arrive while we're elsewhere (e.g. mid-fetch, or the release event after
# a click) get echoed to the screen as stray "special characters". -icanon also
# delivers each byte immediately instead of line-buffering.
SAVED_STTY=$(stty -g 2>/dev/null || true)
stty -echo -icanon min 1 time 0 2>/dev/null || true

printf '\033[?25l\033[?7l'               # hide cursor + disable line-wrap
mouse_on
# On exit, remember the channel we ended on so the next `prefix a` reopens it
# (unless a channel is actively playing — `media popup-channel` decides). Also
# restore the cursor, mouse reporting, and the saved tty mode. Runs on q/Esc,
# the `?` round-trip break, and SIGHUP.
cleanup() {
    mouse_off
    printf '\033[?25h\033[?7h'
    [ -n "${SAVED_STTY:-}" ] && stty "$SAVED_STTY" 2>/dev/null
    "$MEDIA" popup-channel --set "$CHANNEL" 2>/dev/null
}
trap cleanup EXIT

# Pull the progress bar + marquee label for the active channel into the
# cached snapshot. Speech marquee = the caller pane's title; music marquee =
# the current track. Trims surrounding whitespace; collapses newlines.
fetch() {
    local t smc=""
    if [ "$CHANNEL" = "music" ]; then
        # Fused status+label: one `media` spawn AND one phone round-trip.
        # `now-status` follows the live backend (phone mpv when `play --where
        # auto` routed there, else Mopidy) — separate status/now calls would
        # each re-probe the phone bridge.
        { IFS= read -r STATUS; IFS= read -r t; } < <(
            $MEDIA music now-status --show-idle --no-bar 2>/dev/null)
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="(no music)"
        LINK=$(url_for "$(mpd_currentsong_file)")
    elif [ "$CHANNEL" = "book" ]; then
        STATUS=$($MEDIA book status --show-idle --no-bar 2>/dev/null)
        # `media book now` yields a bare URI; the socket's media-title reads
        # far nicer in the marquee. Falls back to a placeholder when idle.
        t=$(printf '{"command":["get_property","media-title"]}\n' \
              | socat - "UNIX-CONNECT:$BOOK_SOCK" 2>/dev/null | jq -r '.data // empty' 2>/dev/null \
              | tr '\n' ' ')
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="(audiobook)"
        LINK=$(url_for "$(sock_get path)")
    else
        # One aggregate call — status line + speaking-pane title + durable-mute
        # count — instead of three separate `media` spawns. Each spawn is a full
        # Python startup (~0.1s), and the popup refreshes every ~1s and after
        # every key, so three-into-one is what makes it feel responsive. Emits
        # exactly three lines (any may be empty).
        #
        # When called WITH args (a fusable speech key's verb), fuse the action
        # into this same spawn via `--act`: the reply then has a leading line
        # (the action's own stdout, e.g. replay-prev's cursor → ACT_OUT) before
        # the three status fields, so a keypress costs one spawn, not two.
        ACT_OUT=""
        if [ "$#" -gt 0 ]; then
            { IFS= read -r ACT_OUT; IFS= read -r STATUS; IFS= read -r t; IFS= read -r smc; } < <(
                TTS_POPUP_PANE="$HL_PANE" $MEDIA popup-status --show-idle --no-bar --act "$@" 2>/dev/null)
        else
            { IFS= read -r STATUS; IFS= read -r t; IFS= read -r smc; } < <(
                TTS_POPUP_PANE="$HL_PANE" $MEDIA popup-status --show-idle --no-bar 2>/dev/null)
        fi
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="agent-media"
        LINK=""                          # speech marquee is a pane title, not a URL
    fi
    # Refresh socket-backed indicators (speech/book have a socket; music/MPD
    # doesn't). Sync the bump base so a following [ / ] starts from reality.
    SPD=""; MUTED=""; MCOUNT=""; PART=""; LOADING=""; IDLE=""
    # Derive mute from the CLI's own [M] marker (works on any channel), then
    # strip the text — we render a single 🔇 glyph instead of [M] + glyph.
    case "$STATUS" in *'[M]'*) MUTED=1 ;; esac
    STATUS="${STATUS/ \[M\]/}"
    # Total durable mutes (the "don't forget you muted things" badge). The
    # *subject's* own mute is shown in the title (🔒 prefix from `now-pane`);
    # this is the global count. Speech-only; folded into the popup-status call
    # above (`smc`) so it costs no extra spawn.
    [ "$CHANNEL" = "speech" ] && MCOUNT="$smc"
    STATUS="${STATUS// \/ //}"               # "1:23 / 4:56" → "1:23/4:56" (save 2 cols)
    # Reflect the *persisted* auto-highlight state, not just v-key toggles made
    # this popup session, so the timeline indicator is right the moment we open.
    # Mirrors submit._is_auto_highlight_enabled: env override wins, else the flag
    # file holds "1". (Speech-only feature, but cheap; derive on every channel.)
    if [ -n "${MEDIA_AUTO_HIGHLIGHT:-}" ]; then
        [ "$MEDIA_AUTO_HIGHLIGHT" != 0 ] && HL=on || HL=off
    elif [ "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/agent-media/auto-highlight" 2>/dev/null)" = 1 ]; then
        HL=on
    else
        HL=off
    fi
    case "$CHANNEL" in
        book)
            # Book plays locally on this host, so its live speed/mute come
            # straight off the socket. Speech may play on a *remote* target
            # (the phone) — its mute rides in on `media status` as [M] (caught
            # above) and its speed as the ⏩/🐢 glyph in the status line, both
            # fed from the intake monitor's local mirror. Reading the local
            # socket for speech would just report red5's idle broker (1.0×,
            # unmuted) and clobber the real remote state.
            [ "$(sock_get mute)" = "true" ] && MUTED=1
            SPD=$(sock_get speed)   # mpv returns e.g. 0.700000 — normalize
            [ -n "$SPD" ] && SPD=$(awk -v s="$SPD" 'BEGIN{printf "%.1f", s}')
            bspeed="${SPD:-$bspeed}"
            ;;
    esac
    # Part number, shown only for a genuinely multi-part book/playlist.
    case "$CHANNEL" in
        book)
            local pp pc bdur
            pp=$(sock_get playlist-pos); pc=$(sock_get playlist-count)
            [ -n "$pp" ] && [ "$pp" -ge 0 ] 2>/dev/null && [ -n "$pc" ] && [ "$pc" -gt 1 ] 2>/dev/null && PART="#$(( pp + 1 ))/$pc"
            # Distinguish two "queued but no duration" states so we don't spin
            # the loading animation forever on a dead entry:
            #   pos>=0, no duration  → mpv is on an item, mid yt-dlp/network
            #                          resolve (the 4-25s YouTube gap) = LOADING.
            #   pos=-1, count>=1     → queued but never started (abandoned load
            #                          or stop) = IDLE; spinning would lie.
            if [ -n "$pc" ] && [ "$pc" -ge 1 ] 2>/dev/null; then
                bdur=$(sock_get duration)
                if [ -z "$bdur" ]; then
                    if [ -n "$pp" ] && [ "$pp" -ge 0 ] 2>/dev/null; then
                        LOADING=1
                    else
                        IDLE=1
                    fi
                fi
            fi
            ;;
        music)
            # Position in Mopidy's play queue, shown only when a track is
            # actually current. `song` is absent while stopped (the queue
            # persists across stops), so without the `-n "$sg"` guard a stopped
            # 6-track queue defaulted to a misleading "1/6". `#` marks it as a
            # queue position.
            local sg pl
            sg=$(mpd_get song); pl=$(mpd_get playlistlength)
            [ -n "$sg" ] && [ -n "$pl" ] && [ "$pl" -gt 1 ] 2>/dev/null && PART="#$(( sg + 1 ))/$pl"
            ;;
    esac
}

# Clickable regions, rebuilt every draw(): parallel arrays of row, start col,
# end col (1-based, inclusive) and the action key handle_mouse feeds to
# handle_key. Registered most-specific-first; handle_mouse takes the first hit.
HIT_ROW=(); HIT_S=(); HIT_E=(); HIT_A=()
hit() { HIT_ROW+=("$1"); HIT_S+=("$2"); HIT_E+=("$3"); HIT_A+=("$4"); }

# Optional keyboard focus: ←/→ (or ↑/↓) move a highlight across the buttons,
# Enter activates the highlighted one, Esc clears it. Purely additive — the
# direct hotkeys and Space=play/pause never change, so there's no mode to get
# stuck in. FOCUS is "" (no highlight) or an index into FOCUS_KEYS, whose order
# follows the layout: channel · title(source) · prev · play/pause · next · vol-
# · vol+ · close.
FOCUS=""
FOCUS_KEYS=( $'\t' g '<' ' ' '>' '-' '=' 'q' )
# emit text, reverse-video when this element ($2 = its FOCUS index) is focused.
emit() {
    if [ "$FOCUS" = "$2" ]; then printf '\033[7m%s\033[0m' "$1"
    else printf '%s' "$1"; fi
}

draw() {
    printf '\033[H\033[2J'               # home + clear
    local cols="${COLUMNS:-0}"
    [ "$cols" -le 0 ] && cols=$(tput cols 2>/dev/null || echo 24)
    HIT_ROW=(); HIT_S=(); HIT_E=(); HIT_A=()
    # ---- Row 1: channel glyph (top-left) · marquee · close (top-right) ----
    # The channel glyph doubles as the channel-switch button; the close 'x' is
    # pinned to the far right; the title between them jumps to source on click.
    local prefix
    case "$CHANNEL" in music) prefix='♫ ' ;; book) prefix='☰ ' ;; *) prefix='♪ ' ;; esac
    local avail=$(( cols - ${#prefix} - 3 ))   # reserve left glyph + right 'x'
    [ "$avail" -lt 4 ] && avail=4
    if [ "$LABEL" != "$LAST_LABEL" ]; then
        SCROLL_OFFSET=0; SCROLL_HOLD_COUNT=0; SCROLL_DONE=0; LAST_LABEL="$LABEL"
    fi
    local shown="$LABEL"
    if [ "${#LABEL}" -gt "$avail" ]; then
        if [ "$SCROLL_DONE" -eq 1 ]; then
            shown="${LABEL:0:avail}"               # parked at the start
        else
            local maxoff=$(( ${#LABEL} - avail ))
            shown="${LABEL:SCROLL_OFFSET:avail}"
            if [ "$SCROLL_OFFSET" -ge "$maxoff" ]; then
                # end is in view — hold, then snap back to the start and stop
                if [ "$SCROLL_HOLD_COUNT" -lt "$SCROLL_HOLD_TICKS" ]; then
                    SCROLL_HOLD_COUNT=$(( SCROLL_HOLD_COUNT + 1 ))
                else
                    SCROLL_OFFSET=0; SCROLL_HOLD_COUNT=0; SCROLL_DONE=1
                fi
            elif [ "$SCROLL_OFFSET" -eq 0 ] && [ "$SCROLL_HOLD_COUNT" -lt "$SCROLL_HOLD_TICKS" ]; then
                SCROLL_HOLD_COUNT=$(( SCROLL_HOLD_COUNT + 1 ))   # hold at start
            else
                SCROLL_OFFSET=$(( SCROLL_OFFSET + 1 )); SCROLL_HOLD_COUNT=0
            fi
        fi
    fi
    # Channel glyph (focus 0), then the title (focus 1) — OSC 8-wrapped on
    # music/book so a Ctrl/Cmd-click opens its source. ST is ESC '\' (\033\\).
    printf ' '; emit "$prefix" 0
    if [ -n "$LINK" ]; then
        printf '\033]8;;%s\033\\' "$LINK"   # open hyperlink
        emit "$shown" 1                      # title text (reverse-video if focused)
        printf '\033]8;;\033\\'              # close hyperlink
    else
        emit "$shown" 1
    fi
    printf '\033[1;%dH' "$cols"; emit x 7   # close button (focus 7), far right
    hit 1 "$(( cols - 1 ))" "$cols" q     # close (2-col target)
    hit 1 1 3 $'\t'                        # channel switch (left glyph)
    hit 1 4 "$(( cols - 2 ))" g            # title → go to source
    # ---- Row 2: < · play/pause+progress · > · vol- · vol+ · indicators ----
    # Indicator cluster (only-when-active so it stays small on a ~32-col phone):
    # speed (speech/book) · mute · transient volume. (Auto-highlight ON is shown
    # without spending a column — by tinting the timeline yellow below.)
    # Volume readout first so the transient feedback sits right next to the
    # +/- buttons and isn't the thing that clips off the right edge.
    local ind=""
    [ "$VOL_SHOW" -gt 0 ] && ind="$ind $VOL_TXT"
    [ -n "$PART" ] && ind="$ind $PART"
    [ -n "$SPD" ] && [ "$SPD" != "1.0" ] && ind="$ind ${SPD}×"
    [ -n "$MUTED" ] && ind="$ind 🔇"
    [ -n "$MCOUNT" ] && ind="$ind 🔒$MCOUNT"
    # While the book channel resolves a load (the YouTube gap), show an animated
    # spinner instead of the meaningless `--:--` so it doesn't look hung.
    local status
    if [ -n "$LOADING" ]; then
        SPIN=$(( (SPIN + 1) % ${#SPIN_FRAMES[@]} ))
        status="${SPIN_FRAMES[SPIN]} loading…"
    elif [ -n "$IDLE" ]; then
        # Queued but not playing — tell the user instead of spinning forever.
        status="⏸ idle"
    else
        status="$STATUS"
    fi
    # The progress core is the play/pause *button*, so its leading glyph shows
    # the action it triggers, not the current state — flip play⇄pause (▶ when
    # paused = "click to play"; $PAUSE_GLYPH = ‖ when playing = "click to pause").
    # Both glyphs are single-column, so no padding/width fixups are needed.
    case "$status" in
        '▶'*) status="${PAUSE_GLYPH}${status#▶}" ;;
        '⏸'*) status="▶${status#⏸}" ;;
    esac
    # Lay row 2 out left-to-right, tracking the column each piece lands on so the
    # prev/next/volume buttons that flank the variable-width progress stay
    # hit-testable. Buttons get a 2-col target (glyph + trailing space), which
    # also absorbs a ±1 drift if the state glyph renders double-width. The whole
    # progress core is the play/pause button.
    # %s on every segment so a glyph like '-' isn't read as a printf option.
    # emit() reverse-videos the focused glyph; FOCUS index per element in comments.
    # When speech auto-highlight is ON, tint the timeline (the time/progress
    # after the play/pause glyph) black-on-yellow — a no-extra-column indicator
    # that the copy-mode follow-along is live. Only the time text, not the
    # play/pause button (which `emit` may reverse-video on focus).
    local hlbg='' hlrst=''
    if [ "$CHANNEL" = "speech" ] && [ "$HL" = "on" ]; then
        hlbg='\033[30;43m'; hlrst='\033[0m'
    fi
    printf '\033[2;1H%s' ' '               # row 2, col 1 = leading space
    local col=2
    hit 2 "$col" "$(( col + 1 ))" '<'; emit '< ' 2; col=$(( col + 2 ))        # prev (2)
    local pstart=$col
    # Highlight only the leading play/pause glyph on focus — not the time — but
    # keep the whole progress as the click target.
    emit "${status:0:1}" 3; printf "${hlbg}%s${hlrst}" "${status:1}"; col=$(( col + ${#status} ))  # play/pause (3)
    hit 2 "$pstart" "$(( col - 1 ))" ' '   # progress core = play/pause toggle
    printf '%s' ' '; col=$(( col + 1 ))
    hit 2 "$col" "$(( col + 1 ))" '>'; emit '> ' 4; col=$(( col + 2 ))        # next (4)
    hit 2 "$col" "$(( col + 1 ))" '-'; emit '- ' 5; col=$(( col + 2 ))        # vol- (5)
    hit 2 "$col" "$(( col + 1 ))" '='; emit '+ ' 6; col=$(( col + 2 ))        # vol+ (6)
    ind="${ind# }"                         # the +/- button's trailing space
                                           # already separates it — drop ours
    local room=$(( cols - col + 1 ))       # indicators fill what's left (clipped)
    [ "$room" -gt 0 ] && printf '%s' "${ind:0:room}"
}

# Blocking yes/no prompt drawn over the popup. Returns 0 on y/Y. Used by the
# `g` reopen flows (start ncmpcpp / resume a closed Claude pane's session).
confirm() {           # $1 = prompt text
    mouse_off
    printf '\033[H\033[2J'
    printf ' %s\r\n [y/N] ' "$1"
    local ans; IFS= read -rsn1 ans
    mouse_on
    case "$ans" in y|Y) return 0 ;; *) return 1 ;; esac
}

# Typed seek for the timeline channels (book, music): read a whole timecode
# line and hand it to that channel's `seek` (absolute H:MM:SS, or +90 / -5:00
# for a relative offset). Shows the cursor and enables echo for the duration so
# the user can see what they type, then restores the popup's hidden-cursor
# state. Empty input cancels. Speech has no single timeline — it's navigated by
# sentence (h/l) — so `s` there just points the user at that.
typed_seek() {
    if [ "$CHANNEL" != "book" ] && [ "$CHANNEL" != "music" ]; then
        tmux display-message "⏱ typed seek: book/music only (speech: h/l by sentence)" 2>/dev/null
        return
    fi
    mouse_off
    printf '\033[H\033[2J\033[?25h'                 # clear + show cursor
    printf ' %s seek › H:MM:SS · +90 · -5:00\r\n ➜ ' "$CHANNEL"
    tty_line                                        # echo + line editing for the prompt
    local t; IFS= read -r t
    tty_raw
    printf '\033[?25l'                              # re-hide cursor
    mouse_on
    # `--` ends option parsing so a relative "-5:00" isn't taken as a flag
    # (argparse only treats a bare "-5" as a number, not "-5:00").
    [ -n "$t" ] && $MEDIA "$CHANNEL" seek -- "$t" >/dev/null 2>&1
}

# Open a URL on a timeline channel: music (ducks under speech) or book (pauses
# under speech). Clipboard-first — the tmux paste buffer is the one clipboard
# that works on every host (phone included), so copy a link, then `o` plays it
# with no typing. Bare Enter accepts the buffer URL; typing overrides it; an
# empty prompt with no buffered URL cancels. Speech has no playlist, so `o`
# there points the user at Tab.
typed_open() {
    if [ "$CHANNEL" != "book" ] && [ "$CHANNEL" != "music" ]; then
        tmux display-message "↗ open URL: switch to music or book first (Tab)" 2>/dev/null
        return
    fi
    local buf="" url="" t=""    # init: url stays empty when the buffer isn't a URL (set -u)
    buf=$(tmux show-buffer 2>/dev/null | head -1)
    case "$buf" in http://*|https://*) url="$buf" ;; esac
    mouse_off
    printf '\033[H\033[2J\033[?25h'                 # clear + show cursor
    if [ -n "$url" ]; then
        printf ' %s open › %.38s\r\n [Enter] play · or type a URL to override\r\n ➜ ' "$CHANNEL" "$url"
    else
        printf ' %s open › paste/type a URL (Enter cancels)\r\n ➜ ' "$CHANNEL"
    fi
    tty_line                                        # echo + line editing for the prompt
    IFS= read -r t
    tty_raw
    printf '\033[?25l'                              # re-hide cursor
    mouse_on
    [ -z "$t" ] && t="$url"                         # bare Enter accepts the buffer URL
    [ -n "$t" ] && $MEDIA "$CHANNEL" play "$t" >/dev/null 2>&1
}

# Show a web-UI URL the user can actually open from a phone/SSH session: mel is
# headless and can't open the client's browser, so present it as a tappable OSC 8
# hyperlink (row 1) plus the raw URL (row 2, which most phone terminals auto-link)
# and copy it to the tmux paste buffer. Any key dismisses.
show_link() {  # $1 = url
    mouse_off
    tmux set-buffer -- "$1" 2>/dev/null
    # Enable line-wrap so the full URL shows across the 2 rows instead of being
    # clipped at the popup's right edge (it's normally off). The whole URL is one
    # OSC 8 hyperlink, so it stays tappable even when wrapped; the leading ↗ hints
    # it's a link. Restored to no-wrap on the way out.
    printf '\033[H\033[2J\033[?7h'
    printf ' ↗ \033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$1"
    # NOTE: this in-popup fallback is only used when launched WITHOUT the
    # launcher (no MEDIA_POPUP_LINK_FLAG). The normal `prefix a` path hands the
    # URL to media-popup-open, which shows it in a full-client-width
    # media-popup-link popup so a long URL isn't forced to wrap here.
    IFS= read -rsn1 _
    printf '\033[?7l'
    mouse_on
}

bump_speed() {        # $1 = direction: 1 faster / -1 slower — hops the speed ladder
    local dir="$1"
    # Speech may play on a *remote* target (the phone, Grade B), so route through
    # the target-aware CLI — which owns the same rung ladder — instead of poking
    # red5's idle local mpv over a socket. (Book plays locally; keep its path.)
    if [ "$CHANNEL" = "speech" ]; then
        if [ "$dir" -gt 0 ]; then $MEDIA speed up >/dev/null 2>&1
        else $MEDIA speed down >/dev/null 2>&1; fi
        return
    fi
    local sock; sock=$(sock_for); [ -z "$sock" ] && return
    local cur; cur=$(sock_get speed); [ -z "$cur" ] && cur=1.0
    # At/above 1.0x hop the rungs (1.0 1.5 2.0 3.0); below 1.0x take fine flat 0.1
    # steps. Symmetric for [ and ]. Snap off the live speed — no accel state to
    # drift; set the absolute value (clamped [0.3, 3.0]) so a stale read just re-snaps.
    local v
    v=$(awk -v c="$cur" -v d="$dir" -v rungs="$SPEED_RUNGS" 'BEGIN{
        n=split(rungs, R, " "); eps=1e-6;
        if (d > 0) {
            if (c < 1.0-eps) { v=c+0.1; if (v>1.0) v=1.0 }
            else { v=3.0; for(i=1;i<=n;i++) if(R[i]>c+eps){v=R[i];break} }
        } else {
            if (c > 1.0+eps) { v=1.0; for(i=n;i>=1;i--) if(R[i]<c-eps){v=R[i];break} }
            else { v=c-0.1; if (v<0.3) v=0.3 }
        }
        if (v<0.3) v=0.3; if (v>3.0) v=3.0; printf "%.1f", v
    }')
    [ -z "$v" ] && return
    printf '{"command":["set_property","speed",%s]}\n' "$v" | socat - "UNIX-CONNECT:$sock" >/dev/null 2>&1
    [ "$CHANNEL" = "book" ] && bspeed="$v" || speed="$v"
}

# The book channel exposes no `toggle`; derive play/pause from the status glyph.
book_toggle() {
    # Idle/ended (e.g. the YouTube media URL expired and mpv stopped) isn't a
    # pause — pausing an already-stopped channel is a no-op and leaves you
    # stuck. Reload the last book at its bookmark instead. `book resume`'s
    # idle branch handles the reopen; on a *paused* channel it just unpauses.
    if [ "$(sock_get idle-active)" = "true" ]; then
        $MEDIA book resume 2>/dev/null; return
    fi
    case "$($MEDIA book status --no-bar 2>/dev/null)" in
        '⏸'*) $MEDIA book resume 2>/dev/null ;;
        *)    $MEDIA book pause  2>/dev/null ;;
    esac
}

# The active channel's mpv IPC socket (music is MPD — no socket, returns "").
sock_for() { case "$CHANNEL" in book) printf '%s' "$BOOK_SOCK" ;; speech) printf '%s' "$SPEECH_SOCK" ;; esac; }
sock_get() {  # $1 = mpv property; echoes raw .data, or "" if absent/false/no-socket
    local s; s=$(sock_for); [ -z "$s" ] && return 1
    # UNIX-CONNECT (not a bare filename): a bare filename is GOPEN, which on a
    # missing/removed socket CREATES a regular file and buries the path under
    # written-out queries — after which nothing can ever answer there.
    printf '{"command":["get_property","%s"]}\n' "$1" | socat - "UNIX-CONNECT:$s" 2>/dev/null \
        | jq -r '.data // empty' 2>/dev/null
}

# Music has no mpv socket, but Mopidy speaks MPD — read fields from its
# `status` over the MPD control port. Defaults to loopback; point at a remote
# Mopidy with MOPIDY_MPD_HOST/PORT (the tmux server env usually lacks them, so
# set them in ~/.config/agent-media.env).
MPD_HOST="${MOPIDY_MPD_HOST:-127.0.0.1}"; MPD_PORT="${MOPIDY_MPD_PORT:-6600}"
mpd_get() {  # $1 = status field, e.g. volume
    printf 'status\nclose\n' | socat -T2 - TCP:"$MPD_HOST":"$MPD_PORT" 2>/dev/null \
        | awk -F': ' -v k="$1" '$1==k{print $2; exit}'
}
# The uri of the current music track (MPD `currentsong` → `file:`). Mopidy URIs
# carry the backend scheme (yt:…, http://…); url_for() turns the ones we can
# into a browser-openable link.
mpd_currentsong_file() {
    printf 'currentsong\nclose\n' | socat -T2 - TCP:"$MPD_HOST":"$MPD_PORT" 2>/dev/null \
        | sed -n 's/^file: //p' | head -1
}
# Best-effort map of a backend uri to an http(s) URL, or "" when there's no
# sensible web target. Plain http(s) passes through; common Mopidy-YouTube
# shapes (yt:video:ID, yt:https://…, youtube:video/Title.ID) become watch URLs.
url_for() {  # $1 = uri
    case "$1" in
        http://*|https://*)        printf '%s' "$1" ;;
        yt:https://*|yt:http://*)  printf '%s' "${1#yt:}" ;;
        yt:video:*)                printf 'https://www.youtube.com/watch?v=%s' "${1##*:}" ;;
        youtube:video/*)           printf 'https://www.youtube.com/watch?v=%s' "${1##*.}" ;;
        *)                         printf '' ;;
    esac
}

# Capture a transient volume readout after a -/= press (shown ~1.6s).
show_volume() {
    local v
    if [ "$CHANNEL" = "music" ]; then
        v=$(mpd_get volume); [ "$v" = "-1" ] && v=""   # -1 = Mopidy mixer disabled
    else
        v=$(sock_get volume)
    fi
    # No 🔊 glyph: it sits right after the +/- buttons (context is obvious) and
    # the double-width emoji would clip the % off the right edge on a narrow
    # popup. Plain ASCII keeps the width math exact.
    case "$v" in '') VOL_TXT='vol' ;; *) VOL_TXT="${v%.*}%" ;; esac
    VOL_SHOW=$VOL_TICKS
}

# Run a transport command on the active channel. Avoids the `A && B || C`
# pitfall (where a failing music command would fall through to the speech
# one). On the music channel the args are passed to `media music …`.
xport() {
    # stderr silenced so a transient failure (e.g. MPD unreachable) can't
    # dump a traceback over the popup UI.
    if [ "$CHANNEL" = "music" ]; then $MEDIA music "$@" 2>/dev/null
    elif [ "$CHANNEL" = "book" ]; then $MEDIA book "$@" 2>/dev/null
    else $MEDIA "$@" 2>/dev/null; fi
}

# Dispatch a logical action, identified by the key char it shares with the
# keyboard. The mouse path feeds the same chars, so clicks and keystrokes run
# one code path. Sets QUIT=1 (instead of `break`) to ask the loop to exit.
QUIT=""
handle_key() {
    local key="$1"
    # Transport keys route to the active channel; speech-only keys (r, m,
    # [, ], 0, v) no-op on the music channel.
    case "$key" in
        $'\t') case "$CHANNEL" in
                   speech) CHANNEL=music ;;
                   music)  CHANNEL=book ;;
                   *)      CHANNEL=speech ;;
               esac
               LABEL=""; LAST_LABEL=" "    # force a clean marquee reset
               tmux display-message "♪ channel: $CHANNEL" 2>/dev/null ;;
        # Fusable speech keys stash their verb in SPEECH_ACT (run+redraw in one
        # spawn by the loop); music/book keep their own direct calls.
        ' ') if [ "$CHANNEL" = "book" ]; then book_toggle
             elif [ "$CHANNEL" = "speech" ]; then SPEECH_ACT=(toggle)
             else xport toggle; fi ;;
        # speech: step one sentence (h/l) or paragraph (H/L), falling back to a
        # time-seek when there's no sentence sequence. music: plain time-seek.
        # music/book share one timecode `seek` (signed = relative); the
        # confirmation line is suppressed since the loop redraws right after.
        h)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek -5 >/dev/null 2>&1
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book seek -5 >/dev/null 2>&1
             else SPEECH_ACT=(skip --unit sentence --dir -1 --seek-fallback -5); fi ;;
        l)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek +5 >/dev/null 2>&1
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book seek +5 >/dev/null 2>&1
             else SPEECH_ACT=(skip --unit sentence --dir 1 --seek-fallback 5); fi ;;
        H)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek -30 >/dev/null 2>&1
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book seek -30 >/dev/null 2>&1
             else SPEECH_ACT=(skip --unit paragraph --dir -1 --seek-fallback -30); fi ;;
        L)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek +30 >/dev/null 2>&1
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book seek +30 >/dev/null 2>&1
             else SPEECH_ACT=(skip --unit paragraph --dir 1 --seek-fallback 30); fi ;;
        # Typed seek — book/music (the channels with an absolute timeline).
        s)   typed_seek ;;
        # Open a URL on the active channel — music (ducks) or book (pauses).
        # Clipboard-first: copy a link, then `o`, Enter.
        o)   typed_open ;;
        '-') xport volume -5; show_volume ;;
        '='|'+') xport volume 5; show_volume ;;
        # speech: ⏮ older / ⏭ newer clip (jump to end when on latest).
        # music: previous / next track.
        '<') if [ "$CHANNEL" = "music" ]; then
                 $MEDIA music prev --restart-first
             elif [ "$CHANNEL" = "book" ]; then
                 $MEDIA book prev --restart-first 2>/dev/null   # v2: chapters when available
             else
                 # ⏮ semantics: restart the current turn if we're past its
                 # start, else step back one. `replay-prev` decides and echoes
                 # the resolved cursor (MEDIA_POPUP_PREV_RESTART_S = grace secs)
                 # — the loop folds that echo (ACT_OUT) back into hist_idx.
                 SPEECH_ACT=(replay-prev --idx "$hist_idx")
             fi ;;
        '>') if [ "$CHANNEL" = "music" ]; then
                 $MEDIA music next
             elif [ "$CHANNEL" = "book" ]; then
                 $MEDIA book next 2>/dev/null   # v2: chapters when available
             elif [ "$hist_idx" -gt 1 ]; then
                 hist_idx=$((hist_idx - 1)); SPEECH_ACT=(replay "$hist_idx")
             else
                 SPEECH_ACT=(jump end)
             fi ;;
        # Go to source, then close the popup so you land on it.
        # Music → focus the ncmpcpp pane and jump it to the now-playing song;
        # if none is running, offer to start one. Speech → focus the speaking
        # pane; if it's been closed, offer to resume its Claude session.
        g)   if [ "$CHANNEL" = "music" ]; then
                 if $MEDIA goto-track 2>/dev/null; then QUIT=1; return
                 elif confirm "♫ no ncmpcpp running — start it?"; then
                     $MEDIA open-ncmpcpp 2>/dev/null; QUIT=1; return
                 fi
             elif [ "$CHANNEL" = "book" ]; then
                 if $MEDIA goto-book 2>/dev/null; then QUIT=1; return
                 elif confirm "☰ open mpvc-tui for the book?"; then
                     $MEDIA open-mpvc 2>/dev/null; QUIT=1; return
                 fi
             else
                 _sid=$($MEDIA goto-pane 2>/dev/null); _grc=$?
                 case "$_grc" in
                     0) QUIT=1; return ;;                 # landed on a live pane
                     3) if [ -n "$_sid" ] && \
                           confirm "⊘ pane closed — resume its Claude session?"; then
                            $MEDIA open-session "$_sid" 2>/dev/null; QUIT=1; return
                        fi ;;
                     2) tmux display-message "⊘ that pane is closed" 2>/dev/null ;;
                     *) QUIT=1; return ;;                 # nothing captured
                 esac
             fi ;;
        # Open the channel's web UI: music → Mopidy-Iris, book → mpvc-web. The
        # `media *-web` commands open a browser when a display exists (desktop);
        # headless/phone they just print the URL, so we surface it via a tmux
        # message and stash it in the paste buffer to copy into a browser.
        w)   case "$CHANNEL" in
                 music) _wu=$($MEDIA music-web 2>/dev/null | head -1) ;;
                 book)  _wu=$($MEDIA book-web  2>/dev/null | head -1) ;;
                 *)     _wu="" ;;
             esac
             if [ -z "$_wu" ]; then
                 tmux display-message "↗ web: music/book only" 2>/dev/null
             elif [ -n "${MEDIA_POPUP_LINK_FLAG:-}" ]; then
                 # Hand off to the launcher: it opens a FULL-client-width link
                 # popup, since this 2-row popup (~34 cols) is too narrow for a
                 # long URL and a wrap defeats Termux's long-press URL detection.
                 # Flag = "channel<TAB>url" so it can reopen on this channel.
                 printf '%s\t%s' "$CHANNEL" "$_wu" > "$MEDIA_POPUP_LINK_FLAG"
                 QUIT=1; return
             else
                 show_link "$_wu"          # standalone (no launcher): in-popup
             fi ;;
        # --- speech-only keys below ---
        r)   [ "$CHANNEL" = "speech" ] && { SPEECH_ACT=(replay); hist_idx=1; } ;;
        # Play the clip at the caller pane's copy-mode cursor (or this pane's
        # latest clip if not scrolled into copy-mode). Reset hist_idx so a
        # following < / > walks from the clip we just landed on.
        p)   [ "$CHANNEL" = "speech" ] && \
                 { TTS_POPUP_PANE="$HL_PANE" $MEDIA replay-at-cursor; hist_idx=1; } ;;
        m)   [ "$CHANNEL" = "speech" ] && SPEECH_ACT=(mute) ;;
        # "Keep muted": durable sticky mute of the popup *subject* (what the
        # title shows — now-playing pane, else this caller pane). Distinct from
        # `m`'s momentary broker mute. A muted pane still records history so it
        # can be replayed; it just never plays live or ducks. The subject also
        # stops immediately if it's mid-clip.
        M)   [ "$CHANNEL" = "speech" ] && \
                 { _mr=$(TTS_POPUP_PANE="$HL_PANE" $MEDIA mute-pane --subject toggle 2>/dev/null); \
                   tmux display-message "🔒 ${_mr:-pane mute toggled}" 2>/dev/null; } ;;
        '[') { [ "$CHANNEL" = "speech" ] || [ "$CHANNEL" = "book" ]; } && bump_speed -1 ;;
        ']') { [ "$CHANNEL" = "speech" ] || [ "$CHANNEL" = "book" ]; } && bump_speed 1 ;;
        # Backspace = "undo the speed change" → reset to 1.0 (⌫ is the primary
        # key; 0 kept as an alias). Terminals send DEL (0x7f) or BS (0x08).
        $'\177'|$'\b'|0)
             if [ "$CHANNEL" = "book" ]; then bspeed=1.0; $MEDIA book speed reset 2>/dev/null
             elif [ "$CHANNEL" = "speech" ]; then speed=1.0; $MEDIA speed reset; fi ;;
        v)   # Toggle auto-highlight (copy-mode follow-along) on/off. Speech
             # only; immediate feedback fires for the current sentence and the
             # new state is shown in a tmux message.
             if [ "$CHANNEL" = "speech" ]; then
                 _hl_out=$(TTS_POPUP_PANE="$HL_PANE" $MEDIA highlight-toggle 2>/dev/null)
                 case "$_hl_out" in *OFF*) HL=off ;; *ON*) HL=on ;; esac
                 tmux display-message "♪ ${_hl_out:-highlight: ?}" 2>/dev/null
             fi ;;
        '?') # tmux allows one popup per client, so we can't nest a help popup.
             # Signal the launcher to show it (top-level) and exit, preserving
             # the channel. Fall back to a one-line message if launched without
             # the launcher (no flag in env).
             if [ -n "${MEDIA_POPUP_HELP_FLAG:-}" ]; then
                 printf '%s' "$CHANNEL" > "$MEDIA_POPUP_HELP_FLAG"; QUIT=1; return
             else
                 tmux display-message "Tab chan · Spc play · h/l H/L seek · s typed-seek · o open URL (music/book) · -/= vol · m mute-now · M keep-muted (🔒) · < > prev/next · g src · w web UI (music/book) · [/] speed ⌫ reset · ←→ focus Enter activate Esc clear · click: glyph=chan title=src x=close · row2 < play > -+ · q quit" 2>/dev/null
             fi ;;
        q) QUIT=1; return ;;
        # Enter activates the focused button (←/→ to focus); inert with no focus
        # so Space stays the one-and-only play/pause key. Enter arrives as '' (the
        # tty's ICRNL maps its CR→NL, which read -n1 treats as an empty-line read).
        ''|$'\r'|$'\n') [ -n "$FOCUS" ] && handle_key "${FOCUS_KEYS[FOCUS]}" ;;
        *) : ;;
    esac
}

# Read the remainder of an escape sequence after a leading ESC. Populates
# ESC_KIND (mouse|other), and for mouse: ESC_BTN, ESC_COL, ESC_ROW, ESC_FINAL
# (M=press, m=release). Returns 1 when the ESC stands alone (bare Esc → quit).
read_escape() {
    local c p buf=""
    ESC_KIND=""
    IFS= read -rsn1 -t 0.02 c || return 1     # nothing follows → bare ESC
    case "$c" in '['|'O') p="$c" ;; *) return 1 ;; esac   # CSI / SS3, else bare Esc
    IFS= read -rsn1 -t 0.02 c || return 1
    if [ "$p" = '[' ] && [ "$c" = '<' ]; then # SGR mouse: <btn;col;row(M|m)
        while IFS= read -rsn1 -t 0.02 c; do
            case "$c" in [Mm]) ESC_FINAL="$c"; break ;; *) buf="$buf$c" ;; esac
        done
        ESC_KIND=mouse
        ESC_BTN="${buf%%;*}"
        local rest="${buf#*;}"
        ESC_COL="${rest%%;*}"; ESC_ROW="${rest##*;}"
        return 0
    fi
    case "$c" in                              # arrow keys (CSI or SS3 form)
        A|B|C|D) ESC_KIND=arrow; ESC_ARROW="$c"; return 0 ;;
    esac
    # Other CSI (PgUp/Del/etc.) — drain to the final byte (0x40–0x7E) and drop.
    case "$c" in [@-~]) ESC_KIND=other; return 0 ;; esac
    while IFS= read -rsn1 -t 0.02 c; do case "$c" in [@-~]) break ;; esac; done
    ESC_KIND=other
    return 0
}

# Move the keyboard focus highlight. The first arrow enters selection (left end
# going right, right end going left); after that it wraps around.
focus_move() {  # $1 = +1 (right/down) or -1 (left/up)
    local n=${#FOCUS_KEYS[@]}
    if [ -z "$FOCUS" ]; then
        [ "$1" -gt 0 ] && FOCUS=0 || FOCUS=$(( n - 1 ))
    else
        FOCUS=$(( (FOCUS + $1 + n) % n ))
    fi
}
handle_arrow() {
    case "$ESC_ARROW" in
        C|B) focus_move 1 ;;     # right / down → next button
        D|A) focus_move -1 ;;    # left  / up   → prev button
    esac
}

# Map a parsed mouse event to an action. A left-press is matched against the
# clickable regions draw() registered (channel/close/title on row 1; prev /
# play-pause / next / vol± on row 2); the wheel nudges volume. Sets ACTED=1 when
# it dispatched something, so the caller only pays for a `fetch` on a real action
# (not on the release event or an empty click). Set MEDIA_POPUP_DEBUG=<file> to
# log every parsed event — handy for calibrating row/col.
act() { ACTED=1; handle_key "$1"; }
handle_mouse() {
    [ "$ESC_KIND" = mouse ] || return
    [ -n "${MEDIA_POPUP_DEBUG:-}" ] && \
        printf 'btn=%s col=%s row=%s final=%s\n' \
            "$ESC_BTN" "$ESC_COL" "$ESC_ROW" "$ESC_FINAL" >> "$MEDIA_POPUP_DEBUG"
    [ "$ESC_FINAL" = M ] || return        # press only (ignore the release event)
    case "$ESC_BTN" in
        64) act '=' ; return ;;            # wheel up → vol+
        65) act '-' ; return ;;            # wheel down → vol−
        0)  ;;                             # left button → hit-test below
        *)  return ;;
    esac
    case "$ESC_COL$ESC_ROW" in ''|*[!0-9]*) return ;; esac   # need numeric col/row
    local i
    for i in "${!HIT_ROW[@]}"; do
        if [ "$ESC_ROW" = "${HIT_ROW[i]}" ] && \
           [ "$ESC_COL" -ge "${HIT_S[i]}" ] && [ "$ESC_COL" -le "${HIT_E[i]}" ]; then
            act "${HIT_A[i]}"; return
        fi
    done
}

# Refresh after a keypress/click. A fusable speech key left its verb in
# SPEECH_ACT: run it fused with the redraw (ONE `media` spawn, not two) and fold
# `replay-prev`'s echoed cursor (ACT_OUT) back into hist_idx. Otherwise (music/
# book, or a key that already ran inline) just re-pull the snapshot.
do_refresh() {
    if [ "${#SPEECH_ACT[@]}" -gt 0 ]; then
        fetch "${SPEECH_ACT[@]}"; SPEECH_ACT=()
        case "$ACT_OUT" in ''|*[!0-9]*) : ;; *) hist_idx="$ACT_OUT" ;; esac
    else
        fetch
    fi
    ticks=0
}

# Paint the frame immediately from the seeded defaults so the popup *appears*
# at once, then pull real state (~0.12s) and repaint — rather than blocking on
# the CLI before the first pixel, which read as "slow to come up".
draw
fetch
draw
TICK=0.2          # redraw cadence — fast enough for a smooth marquee
FETCH_EVERY=5     # refresh the CLI snapshot every ~1s (5 × TICK)
ticks=0
while true; do
    # Short timed read: on timeout we scroll the marquee; every FETCH_EVERY
    # timeouts we also re-pull the snapshot. A keypress refreshes immediately.
    IFS= read -rsn1 -t "$TICK" key; rc=$?
    if [ "$rc" -gt 128 ]; then
        ticks=$(( ticks + 1 ))
        [ "$VOL_SHOW" -gt 0 ] && VOL_SHOW=$(( VOL_SHOW - 1 ))
        if [ "$ticks" -ge "$FETCH_EVERY" ]; then fetch; ticks=0; fi
        draw; continue
    fi
    [ "$rc" -ne 0 ] && break
    if [ "$key" = $'\e' ]; then
        # ESC [ … is a mouse click, an arrow (focus nav), or an ignored CSI.
        if read_escape; then
            ACTED=""
            case "$ESC_KIND" in
                mouse) handle_mouse ;;
                arrow) handle_arrow ;;
            esac
            [ -n "$QUIT" ] && break
            # Re-pull the (slow) snapshot only on a real action; always redraw so
            # the focus highlight tracks the arrows without a flicker of fetch.
            [ -n "$ACTED" ] && do_refresh
            draw; continue
        fi
        # Bare Esc: clear the focus highlight first; quit only when none is set.
        if [ -n "$FOCUS" ]; then FOCUS=""; draw; continue; fi
        break
    fi
    handle_key "$key"
    [ -n "$QUIT" ] && break
    # Refresh the snapshot so the bar/label reflect the action immediately
    # (fused into one spawn when the key stashed a SPEECH_ACT verb).
    do_refresh
    draw
done
