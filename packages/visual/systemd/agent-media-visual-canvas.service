[Unit]
Description=agent-media visual canvas — SSE image page shown alongside spoken replies (tailnet-only)
After=network-online.target tailnet-ip.service
Requires=tailnet-ip.service

[Service]
# The venv bin (media, edge-tts) + ~/.local/bin (amux) on PATH: `media say` /
# replay render TTS in-process, so the edge-tts renderer is resolved on PATH —
# a bare service PATH silently drops per-turn audio (canvas.py augments this
# too, belt-and-braces). Mirrors agent-media-sink-speech.service.
Environment=PATH=%h/projects/agent-media/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bind to the Tailscale IP only (never the public interface — the images
# illustrate your replies, same privacy posture as the clip server on 8780).
# TS_IP comes from tailnet-ip.service; a literal address here stops being true
# the moment the tailnet reassigns it, and a MagicDNS name can't be used for a
# bind (resolved once at start, so it loses the boot race with tailscaled).
# Pushers use the name instead: MEDIA_VISUAL_URL=http://<host>:8781.
EnvironmentFile=%t/tailnet-ip.env
ExecStart=%h/projects/agent-media/.venv/bin/media-visual-canvas --bind ${TS_IP} --port 8781
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
