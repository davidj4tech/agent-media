<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.agentmedia.companion"
    android:versionCode="1"
    android:versionName="0.1">

    <!-- INTERNET is required even for a loopback socket. Without it the mpv
         connection fails with EACCES and nothing else in the app works. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read (never change) Do Not Disturb, so an alert is not spoken into a
         phone whose owner has asked not to be disturbed. The ringer switch
         alone does not answer that: on modern Android, DND leaves ringer mode
         at `normal`. Unlike a NotificationListenerService this is an ordinary
         user grant through ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS, so it
         does not trip Play Protect on a sideload. Ungranted, /ringer reports
         `granted=0` and the reader ignores the DND half. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- No NotificationListenerService, ever: Play Protect hard-blocks the
         install of a sideloaded app that declares one, so
         MediaSessionManager.getActiveSessions() is off the table. See
         docs/proposals/2026-08-13-mediasession-spike.md. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The SECOND-CHOICE revive door: WakeReceiver below is knocked on
             first, because a broadcast makes no task and an activity cannot
             avoid making one. This is what call_guard falls back to when the
             broadcast did not take — Android 12+ may refuse a background app's
             foreground-service start, and a refused revive is worse than a
             visible one.
             Exported because the knock comes from Termux, which is another uid;
             NoDisplay + noHistory + excludeFromRecents because it draws nothing
             and finishes in onCreate. Deliberately not MainActivity: that one
             inflates a diagnostic screen on the same main thread the service
             has ten seconds to reach startForeground on. -->
        <activity
            android:name=".WakeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=":wake"
            android:launchMode="singleInstance" />
        <!-- taskAffinity + singleInstance are load-bearing, and were missing.
             The door shows no window of its own, but starting it with NEW_TASK
             under the app's own affinity RAISES THE APP'S TASK: whatever screen
             David last opened comes to the front with it. Every knock from
             call_guard — up to one every five minutes — put the diagnostic
             screen in his face, which is what he reported on 2026-08-19. Its
             own affinity means the knock creates an empty task, finishes, and
             leaves the launcher where it was. -->

        <!-- Which agent-media this phone is a client of, and where its sound
             comes out. Not exported: it holds the token, and a saved change
             restarts the service. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_label" />

        <!-- The visual canvas: packages/visual's page in a WebView, full-bleed.
             NoTitleBar is load-bearing: without it the platform theme draws an
             action bar across the top of a screen whose whole point is being
             full-bleed, and it ate the strip the back chevron and the
             transcript door both live in. On the phone there was then no
             visible way into the transcript at all, while the same page in a
             browser had one — which is what "still nothing" meant, four times.
             Screenshotting the phone was the only thing that showed it.
             Not exported — nothing outside the app has a reason to open it, and
             phase 2 will have the service start it on a figure arriving.
             singleTop so a wake that arrives while it is already up resumes the
             page rather than building a second WebView over the first. -->
        <activity
            android:name=".CanvasActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/canvas_label"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- The event log and the focus switch. Not exported: it is reached
             from the home screen, and it is where the log went when the home
             screen stopped being a diagnostic. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_label" />

        <!-- What played lately, tap to play again. Not exported: it is reached
             from MainActivity, and it can start playback. -->
        <activity
            android:name=".RecentActivity"
            android:exported="false"
            android:label="@string/recent_label" />

        <!-- "Play with agent-media" in the share sheet. NoDisplay because it
             draws nothing and finishes inside onCreate; noHistory and
             excludeFromRecents so a share never leaves a ghost window behind
             the app the link came from. -->
        <!-- Translucent rather than NoDisplay: it asks which channel now, and
             a NoDisplay activity may not draw at all. What shows is the
             dialog; the window behind it stays the app being shared from. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".CompanionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The quiet revive door: a broadcast makes no task, so nothing is
             raised and nothing is resumed behind it. Exported for the same
             reason WakeActivity is — the knock comes from Termux. See
             WakeReceiver for why the activity is still there as the fallback. -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="net.agentmedia.companion.WAKE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
