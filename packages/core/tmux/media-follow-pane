#!/bin/sh
# Toggle the follow-along pane (`media follow`) in the current window.
#
# The copy-mode highlight paints the pane the reply was written in, which only
# works while that pane has scrollback to search. Claude Code and every other
# fullscreen TUI hold the alternate screen: no scrollback, and the app redraws
# over anything we paint. A pane of our own sidesteps all of it.
#
# Split with -d so focus stays where you were typing — the point is to read
# along, not to move house. The pane is marked with a user option rather than
# by matching its command line, because `pane_current_command` on a python
# entry point is "python3", which would also match half the other panes here.
#
#   media-follow-pane [toggle|open|auto|close]
#
# `open` and `close` are idempotent, which is what lets the auto-highlight flag
# drive this: "follow along" is one intent, not two switches to keep in step.
# `auto` is the hands-off variant used by that coupling: it opens a split, but
# declines to open a WINDOW you didn't ask for — an unseen window is clutter,
# not a feature, and on a narrow client that is all it could ever be.
set -eu

ACTION="${1:-toggle}"
WIDTH="${MEDIA_FOLLOW_WIDTH:-46}"

# No server, no view — and no error either: this runs from a speech hook that
# may be nowhere near a terminal.
tmux has-session 2>/dev/null || exit 0

# -a, not this window: on a narrow client the pane is a window of its own (see
# below), and a toggle that couldn't see it would open a second one every press.
existing=$(tmux list-panes -a -F '#{pane_id} #{@media-follow}' 2>/dev/null |
           awk '$2 == "1" { print $1; exit }')

if [ -n "$existing" ]; then
    case "$ACTION" in
        open) exit 0 ;;                 # already there
        *)    tmux kill-pane -t "$existing"; exit 0 ;;
    esac
fi
# `if`, not `[ … ] && exit`: under `set -e` the && form makes the whole script
# exit non-zero on every OTHER action, since the test itself is the last status.
if [ "$ACTION" = "close" ]; then
    exit 0                              # nothing to close
fi

# Where to put it: the client that is actually being looked at. A hook-driven
# `open` runs detached from any pane, and without a target tmux would size the
# split against whatever window happens to be current on the server.
target="${MEDIA_FOLLOW_TARGET:-${TMUX_PANE:-}}"
if [ -z "$target" ]; then
    target=$(tmux display-message -p '#{pane_id}')
fi

# Only split a window wide enough to leave the conversation readable. On a
# narrow one (a phone client, a half-screen terminal) a 46-column split shoved
# the Claude pane down to a SINGLE column — the follow-along has to earn its
# space, not take it. There, it opens as its own window instead: you can't read
# two columns of text on 43 columns anyway.
# new-window takes a WINDOW target; handing it a pane id fails with "can't
# specify pane here" and no view opens at all.
window=$(tmux display-message -p -t "$target" '#{window_id}')
winw=$(tmux display-message -p -t "$target" '#{window_width}')
half=$((winw / 2))
[ "$WIDTH" -lt "$half" ] || WIDTH="$half"

if [ "$winw" -ge "${MEDIA_FOLLOW_MIN_SPLIT:-90}" ]; then
    pane=$(tmux split-window -h -d -t "$target" -l "$WIDTH" \
           -P -F '#{pane_id}' "exec media follow")
else
    # No room to split. A window opened on your behalf is one you have to be
    # told about: detached, it is invisible, and "the follow-along is on" while
    # nothing appears is worse than it being off.
    if [ "$ACTION" = "auto" ]; then
        exit 0
    fi
    pane=$(tmux new-window -d -a -t "$window" -n follow \
           -P -F '#{pane_id}' "exec media follow")
    idx=$(tmux display-message -p -t "$pane" '#{window_index}')
    tmux display-message -t "$target" \
        "follow-along → window $idx (too narrow to split; prefix F closes it)"
fi
tmux set -p -t "$pane" @media-follow 1
tmux select-pane -t "$pane" -T follow
