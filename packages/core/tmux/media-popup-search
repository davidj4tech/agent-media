#!/usr/bin/env bash
# --- read-whole-file guard -------------------------------------------------
# Everything below lives in one brace group, and that is load-bearing.
#
# bash reads a script lazily, from a byte offset in the open file. Edit the
# file while an instance is running and that instance resumes at the old
# offset in the new text — mid-token, mid-function — and starts executing
# whatever happens to be there. For a long-lived popup the visible result is a
# UI whose keys do arbitrary things, including the key that closes it: on
# 2026-08-09 an edit to this file left a popup that could not be quit and cost
# a whole tmux session.
#
# A compound command must be parsed in full before any of it runs, so wrapping
# the body forces bash to read the entire file up front. After that, editing
# the file cannot affect a running copy at all.
{
# Full-size fzf picker for agent-media popup search.
set -u
channel="${1:-book}"
case "$channel" in book|music) ;; *) channel=book ;; esac

err="${TMPDIR:-/tmp}/media-popup-search.err.$$"
trap 'rm -f "$err"' EXIT

# Build the list before fzf so API/config failures stay visible in this popup.
lines=$(media search --lines "$channel" 2>"$err")
rc=$?
if [ "$rc" -ne 0 ]; then
    cat "$err" >&2
    echo
    read -r -p "search failed (enter to close)" _
    exit "$rc"
fi
if [ -z "$lines" ]; then
    echo "media search: no results" >&2
    echo
    read -r -p "enter to close" _
    exit 1
fi

sel=$(printf '%s\n' "$lines" | fzf --with-nth=1 --delimiter=$'\t' --prompt="$channel> ")
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
[ -n "$sel" ] || exit 1

uri=${sel#*$'\t'}
title=${sel%%$'\t'*}
clean_title=$(printf '%s' "$title" | sed 's/  \[[^]]*\]$//')
printf 'Playing: %s\n' "$title"
if [ "$channel" = book ]; then
    out=$(media book play --title "$clean_title" "$uri" 2>&1)
    rc=$?
    printf '%s\n' "$out"
    case "$out" in
        ⬇*) read -r -p "enter to close; playback will start when ready" _ ;;
        *)  sleep 0.8 ;;
    esac
    exit "$rc"
else
    media music play "$uri"
fi
exit $?
}
