#!/usr/bin/env bash
# Open the agent-media control popup at a width that fits the calling client,
# capped so a wide desktop stays tidy but a narrow phone never overflows.
# Invoked from the `prefix a` binding with the client's name/pane/width, which
# tmux expands at key-press time:
#     bind a run-shell -b "media-popup-open '#{client_name}' '#{pane_id}' '#{client_width}'"
set -u
client="${1:-}"; pane="${2:-}"; cw="${3:-34}"
MAX="${MEDIA_POPUP_MAX_W:-34}"; MIN=18
w="$cw"
[ "$w" -gt "$MAX" ] && w="$MAX"
[ "$w" -lt "$MIN" ] && w="$MIN"
exec tmux display-popup ${client:+-c "$client"} -E -w "$w" -h 4 -x R -y 6 \
    -s 'bg=default' -S 'bg=default' \
    "TTS_POPUP_PANE=$pane media-popup"
