#!/usr/bin/env bash
# Scrollable keymap help for the agent-media control popup, shown in a nested
# popup from the main popup's `?` key. The table is taller than a phone popup, so
# this is a tiny self-contained pager: j/k or ↑/↓ scroll a line, space pages,
# g/G jump to top/bottom, q or Esc close. Sized to the popup's actual height
# (LINES/COLUMNS unset so a stale env value can't make it overshoot — the bug
# that left `less` rendering past the visible rows).
#
# Line 1 of the table is intentionally blank: tmux paints a copy-mode/position
# indicator over the popup's first row, which would otherwise clobber the title.
set -u

mapfile -t L <<'EOF'

 ╭ all channels ───────╮
 │ Tab n  next channel │
 │ Spc    play/pause   │
 │ h l    seek -/+5s   │
 │ H L    seek -/+30s  │
 │ - =    volume -/+5  │
 │ < >    prev/next    │
 │ g      go to source │
 │ a      ask pi       │
 │ q      close        │
 ╰─────────────────────╯
 ╭ speech only ────────╮
 │ r      replay last  │
 │ p      clip @cursor │
 │ m      mute now     │
 │ M      keep muted 🔒│
 │ v      highlight    │
 ╰─────────────────────╯
 ╭ book & music ───────╮
 │ s      typed seek   │
 │ o      open URL     │
 │ w      web UI       │
 ╰─────────────────────╯
 ╭ music only ─────────╮
 │ c      chapters     │
 ╰─────────────────────╯
 ╭ speech & book ──────╮
 │ [ ]    speed -/+    │
 │ ⌫      reset speed  │
 ╰─────────────────────╯
 ╭ mouse (click) ──────╮
 │ TL     channel      │
 │ TR     close        │
 │ ttl    source       │
 │ < >    prev/next    │
 │ prog   play/pause   │
 │ whl    volume -/+   │
 ╰─────────────────────╯
 ╭ keyboard focus ─────╮
 │ ← →    move focus   │
 │ Ent    activate     │
 │ Esc    clear focus  │
 ╰─────────────────────╯
EOF

# Colorize: box frames in the pane-border grey (colour245 ≈ #8a8a8a), section
# titles embedded in the top border in the popup border's blue (colour39 =
# #00afff, bold) — the same title-on-a-border motif as the pane titles. Done
# here, not in the heredoc, to keep the table itself grep-/edit-friendly.
B=$'\033[38;5;245m'; H=$'\033[1;38;5;39m'; R=$'\033[0m'
for i in "${!L[@]}"; do
    line=${L[i]}
    case "$line" in
        ' ╭'*) rest=${line#' ╭ '}; rest=${rest%╮}
               title=${rest%% ─*}; dashes=${rest#"$title"}
               L[i]=" ${B}╭ ${R}${H}${title}${R}${B}${dashes}╮${R}" ;;
        ' │'*) inner=${line#' │'}; inner=${inner%│}
               L[i]=" ${B}│${R}${inner}${B}│${R}" ;;
        ' ╰'*) L[i]=" ${B}${line# }${R}" ;;
    esac
done

# The popup's real size from the pty winsize (ioctl) — not $LINES/$COLUMNS or
# tput, both of which can carry a stale value and make the pager overshoot.
sz=$(stty size 2>/dev/null </dev/tty) || sz=""
rows=${sz% *}; cols=${sz#* }
case "$rows" in ''|*[!0-9]*) rows=20 ;; esac
case "$cols" in ''|*[!0-9]*) cols=24 ;; esac
total=${#L[@]}
view=$(( rows > 1 ? rows - 1 : rows ))     # last row is the footer hint
maxoff=$(( total - view )); [ "$maxoff" -lt 0 ] && maxoff=0
off=0

printf '\033[?25l\033[?7l'                 # hide cursor + disable line-wrap
cleanup() { printf '\033[?7h\033[?25h\033[H\033[2J'; }
trap cleanup EXIT

draw() {
    printf '\033[H\033[2J'
    local i end=$(( off + view ))
    [ "$end" -gt "$total" ] && end=$total
    for (( i = off; i < end; i++ )); do printf '%s\r\n' "${L[i]}"; done
    # Footer pinned to the bottom row: scroll arrows (only when there's more in
    # that direction) + key hint, white on subtle grey (reverse-video read as a
    # glaring white bar), clipped to width.
    local up="·" dn="·"
    [ "$off" -gt 0 ] && up="↑"
    [ "$off" -lt "$maxoff" ] && dn="↓"
    local hint
    if [ "$maxoff" -eq 0 ]; then hint=" q/Esc close"
    else hint=" $up$dn j/k scroll · q/Esc quit"; fi
    printf '\033[%d;1H\033[48;5;237;38;5;231m%s\033[0m' "$rows" "${hint:0:cols}"
}

draw
while :; do
    IFS= read -rsn1 c || break
    case "$c" in
        j)   off=$(( off + 1 )) ;;
        k)   off=$(( off - 1 )) ;;
        ' ') off=$(( off + view )) ;;
        g)   off=0 ;;
        G)   off=$maxoff ;;
        q)   break ;;
        $'\e')
            # Esc alone closes; Esc [ … is an arrow / page key. Disambiguate on
            # a short timeout (a real Esc has no bytes trailing it).
            if IFS= read -rsn1 -t 0.02 c2; then
                if [ "$c2" = '[' ]; then
                    IFS= read -rsn1 -t 0.02 c3
                    case "$c3" in
                        A) off=$(( off - 1 )) ;;                 # ↑
                        B) off=$(( off + 1 )) ;;                 # ↓
                        5) off=$(( off - view )); IFS= read -rsn1 -t 0.02 _ ;;  # PgUp
                        6) off=$(( off + view )); IFS= read -rsn1 -t 0.02 _ ;;  # PgDn
                    esac
                fi
                # other Esc sequence → ignore
            else
                break                                            # bare Esc → quit
            fi ;;
    esac
    [ "$off" -gt "$maxoff" ] && off=$maxoff
    [ "$off" -lt 0 ] && off=0
    draw
done
