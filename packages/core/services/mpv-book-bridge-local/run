#!/data/data/com.termux/files/usr/bin/sh
# mpv-book-bridge-local — the sink-book mpv IPC socket, exposed on loopback for
# the on-device agent-media companion app.
#
# The third of the local bridges, and it exists for the same two reasons as the
# other two: the socket lives inside com.termux's private UID sandbox so no
# other app can open it, and the tailnet bridge (mpv-book-bridge) must not be
# widened — it resolves its bind address from a conf file and would otherwise
# put the IPC socket on whatever wifi p8a is joined to.
#
# Same port number as the tailnet bridge on purpose -- different bind address,
# so there is no conflict and one number to remember. Override with
# MEDIA_BOOK_BRIDGE_LOCAL_PORT.
#
# What the app needs it for: the shade's media player shows one card per
# MediaSession, and the app publishes one per channel. Without this bridge the
# book channel is a card the app cannot fill — it would know nothing about what
# is playing, or whether anything is. See ../../../../android/companion/README.md.
#
# Lives here rather than in dotfiles, with the brokers beside it, because its
# only consumer is the app in this repo: the two move together. The *tailnet*
# bridges are still dotfiles' — which address a device exposes is a property of
# the device, not of agent-media. p8a wires this up as a whole-dir symlink
# (source: link in ansible/host_vars/p8a.yml).
exec 2>&1
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agent-media"
SOCK="$STATE/sink-book.sock"
PORT="${MEDIA_BOOK_BRIDGE_LOCAL_PORT:-6603}"

# Don't start before sink-book has created its socket. Unlike speech, a book
# broker may legitimately never be started on a given day — after the wait the
# socat exits, runit backs off, and it retries. That is the intended shape: the
# bridge follows the broker rather than requiring it.
i=0
while [ ! -S "$SOCK" ] && [ $i -lt 60 ]; do i=$((i + 1)); sleep 1; done

echo "mpv-book-bridge-local: 127.0.0.1:$PORT -> $SOCK"
exec socat "TCP4-LISTEN:$PORT,bind=127.0.0.1,reuseaddr,fork" "UNIX-CONNECT:$SOCK"
