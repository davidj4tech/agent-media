#!/usr/bin/env bash
# Interactive agent-media control popup — runs inside `tmux display-popup -E`.
# A compact key-capture overlay; the live progress bar lives in the status
# line (`media status`). Single-key hotkeys drive the `media` CLI:
#
#   Space   play/pause toggle          r   replay latest clip
#   h / l   seek -5s / +5s             H / L   seek -30s / +30s
#   - / =   volume -5 / +5             m   toggle mute
#   [ / ]   slower / faster (0.1)      0   reset speed
#   < / >   replay older / newer       v   jump to spoken text in copy-mode
#   ?       help                       q / Esc   close
#
# Caller pane for `v` comes from TTS_POPUP_PANE (set by the tmux binding).
set -u
MEDIA="${MEDIA:-media}"
# Caller pane for the `v` show-text. Prefer the binding's TTS_POPUP_PANE,
# but fall back to asking tmux directly — inside a display-popup the
# attached session's active pane *is* the caller, so the highlight works
# even when the env hop didn't carry (the old popup's failure mode).
HL_PANE="${TTS_POPUP_PANE:-}"
case "$HL_PANE" in *'#{'*) HL_PANE="" ;; esac
[ -z "$HL_PANE" ] && {
    _sess=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    [ -n "$_sess" ] && HL_PANE=$(tmux display-message -p -t "$_sess:" '#{pane_id}' 2>/dev/null || true)
}

speed=1.0
hist_idx=1

printf '\033[?25l'                       # hide cursor
cleanup() { printf '\033[?25h'; }        # restore on exit
trap cleanup EXIT

draw() {
    printf '\033[H\033[2J'               # home + clear
    printf ' ♪ agent-media\r\n'
    printf ' %s\r\n' "$($MEDIA status --show-idle --width 8 2>/dev/null)"
}

bump_speed() {        # $1 = +/- delta
    speed=$(awk -v s="$speed" -v d="$1" 'BEGIN{v=s+d; if(v<0.3)v=0.3; if(v>3)v=3; printf "%.1f", v}')
    $MEDIA speed "$speed" 2>/dev/null
}

draw
while true; do
    # Timed read so the status bar redraws ~1/s even with no keypress.
    IFS= read -rsn1 -t 2 key; rc=$?
    if [ "$rc" -gt 128 ]; then draw; continue; fi
    [ "$rc" -ne 0 ] && break
    case "$key" in
        ' ') $MEDIA toggle ;;
        r)   $MEDIA replay; hist_idx=1 ;;
        h)   $MEDIA seek -5 ;;
        l)   $MEDIA seek 5 ;;
        H)   $MEDIA seek -30 ;;
        L)   $MEDIA seek 30 ;;
        '-') $MEDIA volume -5 ;;
        '='|'+') $MEDIA volume 5 ;;
        m)   $MEDIA mute ;;
        '[') bump_speed -0.1 ;;
        ']') bump_speed 0.1 ;;
        0)   speed=1.0; $MEDIA speed reset ;;
        # ⏮ older clip in history; ⏭ newer clip, or jump to end of the
        # current clip when already on the latest.
        '<') hist_idx=$((hist_idx + 1)); $MEDIA replay "$hist_idx" || hist_idx=$((hist_idx - 1)) ;;
        '>') if [ "$hist_idx" -gt 1 ]; then
                 hist_idx=$((hist_idx - 1)); $MEDIA replay "$hist_idx"
             else
                 $MEDIA jump end
             fi ;;
        v)   # Re-trigger copy-mode search in the caller pane.
             # Uses first substantial line (≥20 chars) as anchor, up to 120
             # chars, ERE-escaped. Sends: history-bottom → search-backward.
             if [ -n "$HL_PANE" ]; then
                 txt=$($MEDIA text 2>/dev/null)
                 snippet=""
                 while IFS= read -r line; do
                     line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//')
                     [ "${#line}" -ge 20 ] && snippet="$line" && break
                 done <<< "$txt"
                 [ -z "$snippet" ] && snippet=$(printf '%s' "$txt" | tr '\n' ' ')
                 # Trim to last word boundary within 50 chars so the snippet
                 # stays within one visual line (tmux won't match across wraps).
                 snippet=$(printf '%s' "$snippet" | cut -c1-50)
                 snippet=$(printf '%s' "$snippet" | sed 's/ [^ ]*$//')
                 snippet=$(printf '%s' "$snippet" \
                     | sed 's/[][(){}^$.*+?|\\]/\\&/g')
                 if [ -n "$snippet" ]; then
                     tmux copy-mode -t "$HL_PANE" 2>/dev/null
                     tmux send-keys -t "$HL_PANE" -X history-bottom 2>/dev/null
                     tmux send-keys -t "$HL_PANE" -X search-backward "$snippet" 2>/dev/null
                 fi
             fi ;;
        '?') tmux display-message "Space play/pause · r replay · h/l ±5s · -/= vol · m mute · [/] speed · < > history · v jump to text · q quit" 2>/dev/null ;;
        q|$'\e') break ;;
        *) : ;;
    esac
    draw
done
