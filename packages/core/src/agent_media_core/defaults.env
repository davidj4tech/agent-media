# agent-media universal defaults — shipped in the package, LOWEST precedence.
#
# load_env_file layers env files: real env vars win, then an explicit
# $MEDIA_ENV_FILE, then machine-local ~/.config/agent-media.env, then this
# file fills whatever is still unset. So these are the cross-host defaults a
# fresh checkout gets with no config at all; any machine-local file overrides
# them per-key.
#
# Only HOST-AGNOSTIC settings belong here. Routing (sinks/targets), Snapcast
# latency, and per-host pause targets are machine-specific — keep those in the
# machine-local ~/.config/agent-media.env, not here.

# Default render engine. edge needs no API key, so it's the safe universal
# default; hosts with OPENAI_API_KEY/DASHSCOPE_API_KEY can override locally.
MEDIA_RENDER_ENGINE=edge

# Per-engine default voices. Each engine has its own voice namespace, so the
# voice always matches whichever engine renders (sending an edge voice to qwen
# is the DashScope 400). submit._resolve_voice reads MEDIA_RENDER_VOICE_<ENGINE>.
MEDIA_RENDER_VOICE_EDGE=en-AU-NatashaNeural
MEDIA_RENDER_VOICE_QWEN=Cherry
MEDIA_RENDER_VOICE_OPENAI=marin
MEDIA_RENDER_VOICE_REALTIME=marin

# Optional LLM "spoken summary": rewrite a long Claude Code reply into short
# speech-friendly prose (describing code/tables, dropping URLs) instead of the
# mechanical markdown-strip. Off by default. Runs in the detached playback child
# (never blocks the hook) and shells out to an `openai`-capable interpreter,
# reusing OPENAI_API_KEY / OPENAI_BASE_URL — point OPENAI_BASE_URL at a local
# gateway + set MEDIA_SUMMARY_MODEL to a local model to keep it off-cloud.
MEDIA_SPEECH_SUMMARY=0
MEDIA_SUMMARY_MODEL=gpt-4o-mini
MEDIA_SUMMARY_MIN_CHARS=320
MEDIA_SUMMARY_TIMEOUT=20
