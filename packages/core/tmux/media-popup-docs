#!/usr/bin/env bash
# Full-size fzf document browser (popup `d`).
# Lists everything under the doc roots — title, date, kind, status — newest
# dated first, reference after. Enter renders (cached) and plays it on the
# book channel, so chapters, resume position and speed all work on it the way
# they do for an audiobook. A document is a short audiobook.
#
# First play of a long document is tens of seconds of synthesis, so say so:
# otherwise the popup closes and nothing appears to happen.
set -u
list_cmd="media doc list --lines"

err="${TMPDIR:-/tmp}/media-popup-docs.err.$$"
trap 'rm -f "$err"' EXIT

die() {                     # never vanish silently: the popup closing with no
    echo "$*" >&2           # output is indistinguishable from "nothing happened"
    echo
    read -r -p "enter to close" _
    exit 1
}

command -v fzf >/dev/null 2>&1 || die "media-popup-docs: fzf is not installed"

# Build the view before fzf so a backend failure stays visible here rather
# than becoming an empty picker.
if ! lines=$($list_cmd 2>"$err"); then
    die "media doc list failed:$(printf '\n')$(cat "$err")"
fi

# The agenda first, and always: it is the one entry whose value is that it is
# current, so it should never be something you have to go and find. Everything
# else in this list is a document; this is the day.
lines=$(printf 'Today'"'"'s agenda  (now)\t--agenda\n%s\n' "$lines")

sel=$(printf '%s\n' "$lines" \
    | fzf --with-nth=1 --delimiter=$'\t' --prompt='docs> ' \
          --header='enter listen (renders on first play) · esc cancel')
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"          # esc / ctrl-c: a deliberate no-op
[ -n "$sel" ] || exit 0

slug=${sel#*$'\t'}
[ "$slug" != "$sel" ] && [ -n "$slug" ] || die "media-popup-docs: no slug in selection"

if [ "$slug" = "--agenda" ]; then
    printf 'building the agenda ...\n'
    media doc agenda || die "media doc agenda failed"
else
    # Rendering a long document is tens of seconds of synthesis on first play,
    # so say what is happening — an unexplained pause reads as a hang.
    printf 'rendering %s ...\n' "$slug"
    media doc play "$slug" || die "media doc play $slug failed"
fi
