[Unit]
Description=Move Meridian job records older than a week out of ~/.claude/jobs

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/projects/agent-media/packages/core/scripts/meridian-jobs-prune.py
