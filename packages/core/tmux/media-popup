#!/usr/bin/env bash
# Interactive agent-media control popup — runs inside `tmux display-popup -E`.
# A compact two-line overlay: line 1 is a marquee (the title of the pane that
# produced the now-playing speech; the current track on the music channel),
# line 2 is the live clock. Tab cycles channels; single-key hotkeys drive the
# `media` CLI and route to the active channel:
#
#   Tab     switch channel (speech ⇆ music ⇆ book)
#   Space   play/pause toggle          r   replay latest clip   (speech)
#   p       play clip at copy-mode cursor (speech) — the spoken clip whose
#           text sits at/above the cursor; no copy-mode → this pane's latest
#   h / l   prev/next sentence         H / L   prev/next paragraph
#           (speech; ±5s/±30s seek on music & book)
#   - / =   volume -5 / +5             m   toggle mute           (speech/music)
#   [ / ]   slower / faster (0.1)      0   reset speed           (speech/book)
#   < / >   speech: replay older/newer · music: prev/next track ·
#           book: prev/next part (chapters in a later pass)
#   v       toggle auto-highlight (speech)   ?  help   q / Esc  close
#
# Caller pane for `v`/the speech marquee comes from TTS_POPUP_PANE (set by
# the tmux binding).
set -u
MEDIA="${MEDIA:-media}"
# Caller pane for the `v` show-text. Prefer the binding's TTS_POPUP_PANE,
# but fall back to asking tmux directly — inside a display-popup the
# attached session's active pane *is* the caller, so the highlight works
# even when the env hop didn't carry (the old popup's failure mode).
HL_PANE="${TTS_POPUP_PANE:-}"
case "$HL_PANE" in *'#{'*) HL_PANE="" ;; esac
[ -z "$HL_PANE" ] && {
    _sess=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    [ -n "$_sess" ] && HL_PANE=$(tmux display-message -p -t "$_sess:" '#{pane_id}' 2>/dev/null || true)
}
# Export so child processes (`media replay`, `media replay-track`) see the
# resolved pane id rather than the literal '#{pane_id}' that some tmux
# versions leave unexpanded.
export TTS_POPUP_PANE="$HL_PANE"

speed=1.0
bspeed=1.0              # book channel speed (tracked separately from speech)
hist_idx=1
CHANNEL=speech          # active channel: speech | music | book (Tab cycles)
BOOK_SOCK="${MEDIA_BOOK_SOCKET:-$HOME/.local/state/agent-media/sink-book.sock}"
SPEECH_SOCK="${MEDIA_SPEECH_SOCKET:-$HOME/.local/state/agent-media/sink-speech.sock}"
# Indicator state (line-2 cluster). Read fresh from the active channel's socket
# each fetch so they're honest regardless of who changed them.
MUTED=""        # 1 when the active channel is muted
SPD=""          # active channel's actual speed ("" / "1" → hidden)
PART=""         # "2/5" when a multi-part book/playlist is active
LOADING=""      # 1 while the book channel is resolving a load (YouTube gap)
SPIN=0          # spinner frame index (advances each draw while LOADING)
SPIN_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
HL=""           # speech auto-highlight: on|off (tracked from the v key)
VOL_SHOW=0      # ticks remaining to show the transient volume readout
VOL_TXT=""      # the transient volume readout text
VOL_TICKS=8     # ~1.6s at TICK=0.2

# Cached snapshot of the CLI state. The draw loop ticks fast (TICK) so the
# marquee scrolls smoothly, but the `media` CLI costs ~150ms/call, so we
# only refresh this snapshot every FETCH_EVERY ticks (~1s) — and right after
# a keypress so actions feel instant.
LABEL="agent-media"     # marquee text (pane title / current track)
STATUS=""               # second line: progress bar for the active channel

# Marquee state. When LABEL is wider than the line, draw() scrolls it once
# (a single left-to-right pass), holding briefly at each end, then parks at
# the start (SCROLL_DONE) and stays put until LABEL changes.
LAST_LABEL=""
SCROLL_OFFSET=0
SCROLL_HOLD_TICKS=6
SCROLL_HOLD_COUNT=0
SCROLL_DONE=0

printf '\033[?25l'                       # hide cursor
cleanup() { printf '\033[?25h'; }        # restore on exit
trap cleanup EXIT

# Pull the progress bar + marquee label for the active channel into the
# cached snapshot. Speech marquee = the caller pane's title; music marquee =
# the current track. Trims surrounding whitespace; collapses newlines.
fetch() {
    local t
    if [ "$CHANNEL" = "music" ]; then
        STATUS=$($MEDIA music status --show-idle --no-bar 2>/dev/null)
        t=$($MEDIA music now 2>/dev/null | tr '\n' ' ')
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="(no music)"
    elif [ "$CHANNEL" = "book" ]; then
        STATUS=$($MEDIA book status --show-idle --no-bar 2>/dev/null)
        # `media book now` yields a bare URI; the socket's media-title reads
        # far nicer in the marquee. Falls back to a placeholder when idle.
        t=$(printf '{"command":["get_property","media-title"]}\n' \
              | socat - "$BOOK_SOCK" 2>/dev/null | jq -r '.data // empty' 2>/dev/null \
              | tr '\n' ' ')
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="(audiobook)"
    else
        STATUS=$($MEDIA status --show-idle --no-bar 2>/dev/null)
        # Title of the pane that produced the *currently playing* speech
        # (not the active pane), so the marquee names who's talking.
        t=$($MEDIA now-pane 2>/dev/null | tr '\n' ' ')
        t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ -n "$t" ] && LABEL="$t" || LABEL="agent-media"
    fi
    # Refresh socket-backed indicators (speech/book have a socket; music/MPD
    # doesn't). Sync the bump base so a following [ / ] starts from reality.
    SPD=""; MUTED=""; PART=""; LOADING=""
    # Derive mute from the CLI's own [M] marker (works on any channel), then
    # strip the text — we render a single 🔇 glyph instead of [M] + glyph.
    case "$STATUS" in *'[M]'*) MUTED=1 ;; esac
    STATUS="${STATUS/ \[M\]/}"
    case "$CHANNEL" in
        speech|book)
            [ "$(sock_get mute)" = "true" ] && MUTED=1
            SPD=$(sock_get speed)   # mpv returns e.g. 0.700000 — normalize
            [ -n "$SPD" ] && SPD=$(awk -v s="$SPD" 'BEGIN{printf "%.1f", s}')
            [ "$CHANNEL" = "speech" ] && speed="${SPD:-$speed}" || bspeed="${SPD:-$bspeed}"
            ;;
    esac
    # Part number, shown only for a genuinely multi-part book/playlist.
    case "$CHANNEL" in
        book)
            local pp pc bdur
            pp=$(sock_get playlist-pos); pc=$(sock_get playlist-count)
            [ -n "$pc" ] && [ "$pc" -gt 1 ] 2>/dev/null && PART="$(( ${pp:-0} + 1 ))/$pc"
            # Loading = a file is queued (playlist-count>=1) but has no duration
            # yet, i.e. mid yt-dlp/network resolve (the 4-25s YouTube gap).
            if [ -n "$pc" ] && [ "$pc" -ge 1 ] 2>/dev/null; then
                bdur=$(sock_get duration)
                [ -z "$bdur" ] && LOADING=1
            fi
            ;;
        music)
            local sg pl
            sg=$(mpd_get song); pl=$(mpd_get playlistlength)
            [ -n "$pl" ] && [ "$pl" -gt 1 ] 2>/dev/null && PART="$(( ${sg:-0} + 1 ))/$pl"
            ;;
    esac
}

draw() {
    printf '\033[H\033[2J'               # home + clear
    # Line 1: marquee of LABEL behind a fixed channel glyph.
    local cols="${COLUMNS:-0}"
    [ "$cols" -le 0 ] && cols=$(tput cols 2>/dev/null || echo 24)
    local prefix
    case "$CHANNEL" in music) prefix='♫ ' ;; book) prefix='☰ ' ;; *) prefix='♪ ' ;; esac
    local avail=$(( cols - ${#prefix} - 1 ))
    [ "$avail" -lt 4 ] && avail=4
    if [ "$LABEL" != "$LAST_LABEL" ]; then
        SCROLL_OFFSET=0; SCROLL_HOLD_COUNT=0; SCROLL_DONE=0; LAST_LABEL="$LABEL"
    fi
    local shown="$LABEL"
    if [ "${#LABEL}" -gt "$avail" ]; then
        if [ "$SCROLL_DONE" -eq 1 ]; then
            shown="${LABEL:0:avail}"               # parked at the start
        else
            local maxoff=$(( ${#LABEL} - avail ))
            shown="${LABEL:SCROLL_OFFSET:avail}"
            if [ "$SCROLL_OFFSET" -ge "$maxoff" ]; then
                # end is in view — hold, then snap back to the start and stop
                if [ "$SCROLL_HOLD_COUNT" -lt "$SCROLL_HOLD_TICKS" ]; then
                    SCROLL_HOLD_COUNT=$(( SCROLL_HOLD_COUNT + 1 ))
                else
                    SCROLL_OFFSET=0; SCROLL_HOLD_COUNT=0; SCROLL_DONE=1
                fi
            elif [ "$SCROLL_OFFSET" -eq 0 ] && [ "$SCROLL_HOLD_COUNT" -lt "$SCROLL_HOLD_TICKS" ]; then
                SCROLL_HOLD_COUNT=$(( SCROLL_HOLD_COUNT + 1 ))   # hold at start
            else
                SCROLL_OFFSET=$(( SCROLL_OFFSET + 1 )); SCROLL_HOLD_COUNT=0
            fi
        fi
    fi
    printf ' %s%s\r\n' "$prefix" "$shown"
    # Line 2: progress, then a compact indicator cluster (only-when-active so it
    # stays small on a ~32-col phone). speed (speech/book) · mute · highlight
    # (speech) · transient volume.
    local ind=""
    [ -n "$PART" ] && ind="$ind $PART"
    [ -n "$SPD" ] && [ "$SPD" != "1.0" ] && ind="$ind ${SPD}×"
    [ -n "$MUTED" ] && ind="$ind 🔇"
    [ "$CHANNEL" = "speech" ] && [ "$HL" = "on" ] && ind="$ind ✎"
    [ "$VOL_SHOW" -gt 0 ] && ind="$ind $VOL_TXT"
    # While the book channel resolves a load (the YouTube gap), show an animated
    # spinner instead of the meaningless `--:--` so it doesn't look hung.
    local line2
    if [ -n "$LOADING" ]; then
        SPIN=$(( (SPIN + 1) % ${#SPIN_FRAMES[@]} ))
        line2=" ${SPIN_FRAMES[SPIN]} loading…"
    else
        line2=" $STATUS$ind"
    fi
    # Clip line 2 to the popup width so a long book status + indicators can't
    # wrap onto a third row (which would scroll the marquee off the top).
    printf '%s' "${line2:0:cols}"        # no trailing newline (2-row popup)
}

# Blocking yes/no prompt drawn over the popup. Returns 0 on y/Y. Used by the
# `g` reopen flows (start ncmpcpp / resume a closed Claude pane's session).
confirm() {           # $1 = prompt text
    printf '\033[H\033[2J'
    printf ' %s\r\n [y/N] ' "$1"
    local ans; IFS= read -rsn1 ans
    case "$ans" in y|Y) return 0 ;; *) return 1 ;; esac
}

bump_speed() {        # $1 = +/- delta — applies to the active channel
    if [ "$CHANNEL" = "book" ]; then
        bspeed=$(awk -v s="$bspeed" -v d="$1" 'BEGIN{v=s+d; if(v<0.3)v=0.3; if(v>3)v=3; printf "%.1f", v}')
        $MEDIA book speed "$bspeed" 2>/dev/null
    else
        speed=$(awk -v s="$speed" -v d="$1" 'BEGIN{v=s+d; if(v<0.3)v=0.3; if(v>3)v=3; printf "%.1f", v}')
        $MEDIA speed "$speed" 2>/dev/null
    fi
}

# The book channel exposes no `toggle`; derive play/pause from the status glyph.
book_toggle() {
    case "$($MEDIA book status --no-bar 2>/dev/null)" in
        '⏸'*) $MEDIA book resume 2>/dev/null ;;
        *)    $MEDIA book pause  2>/dev/null ;;
    esac
}

# The active channel's mpv IPC socket (music is MPD — no socket, returns "").
sock_for() { case "$CHANNEL" in book) printf '%s' "$BOOK_SOCK" ;; speech) printf '%s' "$SPEECH_SOCK" ;; esac; }
sock_get() {  # $1 = mpv property; echoes raw .data, or "" if absent/false/no-socket
    local s; s=$(sock_for); [ -z "$s" ] && return 1
    printf '{"command":["get_property","%s"]}\n' "$1" | socat - "$s" 2>/dev/null \
        | jq -r '.data // empty' 2>/dev/null
}

# Music has no mpv socket, but Mopidy speaks MPD — read fields from its
# `status` over the MPD control port (defaults: the tailnet IP, since the tmux
# server env usually lacks MOPIDY_MPD_*).
MPD_HOST="${MOPIDY_MPD_HOST:-100.94.154.59}"; MPD_PORT="${MOPIDY_MPD_PORT:-6600}"
mpd_get() {  # $1 = status field, e.g. volume
    printf 'status\nclose\n' | socat -T2 - TCP:"$MPD_HOST":"$MPD_PORT" 2>/dev/null \
        | awk -F': ' -v k="$1" '$1==k{print $2; exit}'
}

# Capture a transient volume readout after a -/= press (shown ~1.6s).
show_volume() {
    local v
    if [ "$CHANNEL" = "music" ]; then
        v=$(mpd_get volume); [ "$v" = "-1" ] && v=""   # -1 = Mopidy mixer disabled
    else
        v=$(sock_get volume)
    fi
    case "$v" in '') VOL_TXT='🔊vol' ;; *) VOL_TXT="🔊${v%.*}%" ;; esac
    VOL_SHOW=$VOL_TICKS
}

# Run a transport command on the active channel. Avoids the `A && B || C`
# pitfall (where a failing music command would fall through to the speech
# one). On the music channel the args are passed to `media music …`.
xport() {
    # stderr silenced so a transient failure (e.g. MPD unreachable) can't
    # dump a traceback over the popup UI.
    if [ "$CHANNEL" = "music" ]; then $MEDIA music "$@" 2>/dev/null
    elif [ "$CHANNEL" = "book" ]; then $MEDIA book "$@" 2>/dev/null
    else $MEDIA "$@" 2>/dev/null; fi
}

fetch
draw
TICK=0.2          # redraw cadence — fast enough for a smooth marquee
FETCH_EVERY=5     # refresh the CLI snapshot every ~1s (5 × TICK)
ticks=0
while true; do
    # Short timed read: on timeout we scroll the marquee; every FETCH_EVERY
    # timeouts we also re-pull the snapshot. A keypress refreshes immediately.
    IFS= read -rsn1 -t "$TICK" key; rc=$?
    if [ "$rc" -gt 128 ]; then
        ticks=$(( ticks + 1 ))
        [ "$VOL_SHOW" -gt 0 ] && VOL_SHOW=$(( VOL_SHOW - 1 ))
        if [ "$ticks" -ge "$FETCH_EVERY" ]; then fetch; ticks=0; fi
        draw; continue
    fi
    [ "$rc" -ne 0 ] && break
    # Transport keys route to the active channel; speech-only keys (r, m,
    # [, ], 0, v) no-op on the music channel.
    case "$key" in
        $'\t') case "$CHANNEL" in
                   speech) CHANNEL=music ;;
                   music)  CHANNEL=book ;;
                   *)      CHANNEL=speech ;;
               esac
               LABEL=""; LAST_LABEL=" "    # force a clean marquee reset
               tmux display-message "♪ channel: $CHANNEL" 2>/dev/null ;;
        ' ') if [ "$CHANNEL" = "book" ]; then book_toggle; else xport toggle; fi ;;
        # speech: step one sentence (h/l) or paragraph (H/L), falling back to a
        # time-seek when there's no sentence sequence. music: plain time-seek.
        h)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek -5 2>/dev/null
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book skip -5 2>/dev/null
             else $MEDIA skip --unit sentence --dir -1 --seek-fallback -5 2>/dev/null; fi ;;
        l)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek 5 2>/dev/null
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book skip 5 2>/dev/null
             else $MEDIA skip --unit sentence --dir 1 --seek-fallback 5 2>/dev/null; fi ;;
        H)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek -30 2>/dev/null
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book skip -30 2>/dev/null
             else $MEDIA skip --unit paragraph --dir -1 --seek-fallback -30 2>/dev/null; fi ;;
        L)   if [ "$CHANNEL" = "music" ]; then $MEDIA music seek 30 2>/dev/null
             elif [ "$CHANNEL" = "book" ]; then $MEDIA book skip 30 2>/dev/null
             else $MEDIA skip --unit paragraph --dir 1 --seek-fallback 30 2>/dev/null; fi ;;
        '-') xport volume -5; show_volume ;;
        '='|'+') xport volume 5; show_volume ;;
        # speech: ⏮ older / ⏭ newer clip (jump to end when on latest).
        # music: previous / next track.
        '<') if [ "$CHANNEL" = "music" ]; then
                 $MEDIA music prev
             elif [ "$CHANNEL" = "book" ]; then
                 $MEDIA book prev 2>/dev/null   # v2: chapters when available
             else
                 hist_idx=$((hist_idx + 1)); $MEDIA replay "$hist_idx" || hist_idx=$((hist_idx - 1))
             fi ;;
        '>') if [ "$CHANNEL" = "music" ]; then
                 $MEDIA music next
             elif [ "$CHANNEL" = "book" ]; then
                 $MEDIA book next 2>/dev/null   # v2: chapters when available
             elif [ "$hist_idx" -gt 1 ]; then
                 hist_idx=$((hist_idx - 1)); $MEDIA replay "$hist_idx"
             else
                 $MEDIA jump end
             fi ;;
        # Go to source, then close the popup so you land on it.
        # Music → focus the ncmpcpp pane and jump it to the now-playing song;
        # if none is running, offer to start one. Speech → focus the speaking
        # pane; if it's been closed, offer to resume its Claude session.
        g)   if [ "$CHANNEL" = "music" ]; then
                 if $MEDIA goto-track 2>/dev/null; then break
                 elif confirm "♫ no ncmpcpp running — start it?"; then
                     $MEDIA open-ncmpcpp 2>/dev/null; break
                 fi
             elif [ "$CHANNEL" = "book" ]; then
                 tmux display-message "☰ book: no source to jump to" 2>/dev/null
             else
                 _sid=$($MEDIA goto-pane 2>/dev/null); _grc=$?
                 case "$_grc" in
                     0) break ;;                          # landed on a live pane
                     3) if [ -n "$_sid" ] && \
                           confirm "⊘ pane closed — resume its Claude session?"; then
                            $MEDIA open-session "$_sid" 2>/dev/null; break
                        fi ;;
                     2) tmux display-message "⊘ that pane is closed" 2>/dev/null ;;
                     *) break ;;                          # nothing captured
                 esac
             fi ;;
        # --- speech-only keys below ---
        r)   [ "$CHANNEL" = "speech" ] && { $MEDIA replay; hist_idx=1; } ;;
        # Play the clip at the caller pane's copy-mode cursor (or this pane's
        # latest clip if not scrolled into copy-mode). Reset hist_idx so a
        # following < / > walks from the clip we just landed on.
        p)   [ "$CHANNEL" = "speech" ] && \
                 { TTS_POPUP_PANE="$HL_PANE" $MEDIA replay-at-cursor; hist_idx=1; } ;;
        m)   [ "$CHANNEL" = "speech" ] && $MEDIA mute ;;
        '[') { [ "$CHANNEL" = "speech" ] || [ "$CHANNEL" = "book" ]; } && bump_speed -0.1 ;;
        ']') { [ "$CHANNEL" = "speech" ] || [ "$CHANNEL" = "book" ]; } && bump_speed 0.1 ;;
        0)   if [ "$CHANNEL" = "book" ]; then bspeed=1.0; $MEDIA book speed reset 2>/dev/null
             elif [ "$CHANNEL" = "speech" ]; then speed=1.0; $MEDIA speed reset; fi ;;
        v)   # Toggle auto-highlight (copy-mode follow-along) on/off. Speech
             # only; immediate feedback fires for the current sentence and the
             # new state is shown in a tmux message.
             if [ "$CHANNEL" = "speech" ]; then
                 _hl_out=$(TTS_POPUP_PANE="$HL_PANE" $MEDIA highlight-toggle 2>/dev/null)
                 case "$_hl_out" in *OFF*) HL=off ;; *ON*) HL=on ;; esac
                 tmux display-message "♪ ${_hl_out:-highlight: ?}" 2>/dev/null
             fi ;;
        '?') # Full keymap in a nested popup, sized to the client so it fits a
             # narrow phone; fall back to a one-line message if it can't open.
             _hw=$(tmux display -p '#{client_width}' 2>/dev/null); _hw=${_hw:-26}
             _hh=$(tmux display -p '#{client_height}' 2>/dev/null); _hh=${_hh:-24}
             [ "$_hw" -gt 30 ] 2>/dev/null && _hw=30
             [ "$_hh" -gt 6 ] 2>/dev/null && _hh=$(( _hh - 2 ))
             tmux display-popup -E -w "$_hw" -h "$_hh" \
                 -s 'bg=default' -S 'bg=default' media-popup-help 2>/dev/null \
               || tmux display-message "Tab channel · Space play/pause · h/l H/L seek · -/= vol · < > prev/next · g source · speech: r p m v · [/] 0 speed · q quit" 2>/dev/null ;;
        q|$'\e') break ;;
        *) : ;;
    esac
    # Refresh the snapshot so the bar/label reflect the action immediately.
    fetch; ticks=0
    draw
done
