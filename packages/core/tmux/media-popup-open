#!/usr/bin/env bash
# Open the agent-media control popup at a width that fits the calling client
# (capped), and drive the help overlay.
#
# tmux allows only ONE popup per client, so the popup's `?` can't open a nested
# help popup (tmux silently ignores it). Instead `?` writes the current channel
# to a flag file and exits; here we detect the flag, open the help as a normal
# (top-level) popup, then reopen the main popup at the same channel. Repeats so
# `?` can be pressed again.
#
# Invoked from the `prefix a` binding with the client's name/pane/width/height,
# which tmux expands at key-press time.
set -u
client="${1:-}"; pane="${2:-}"; cw="${3:-34}"; ch="${4:-24}"

# Marker so the highlight follow-along knows the popup is open for this pane and
# can override its keystroke-skip (an open popup means you're attending to
# playback). Holds the controlled pane id; removed on exit (incl. close/`q`).
openmark="${XDG_STATE_HOME:-$HOME/.local/state}/agent-media/popup-open"
mkdir -p "$(dirname "$openmark")" 2>/dev/null
printf '%s' "$pane" > "$openmark" 2>/dev/null
trap 'rm -f "$openmark"' EXIT

MAX="${MEDIA_POPUP_MAX_W:-34}"; MIN=18
w="$cw"; [ "$w" -gt "$MAX" ] && w="$MAX"; [ "$w" -lt "$MIN" ] && w="$MIN"
# Help popup geometry — the keymap table is ~23 cols x ~26 rows.
hw="$cw"; [ "$hw" -gt 30 ] && hw=30
hh="$ch"; [ "$hh" -gt 5 ] && hh=$(( hh - 1 ))

flag="${TMPDIR:-/tmp}/media-popup-help.$$"
linkflag="${TMPDIR:-/tmp}/media-popup-link.$$"
searchflag="${TMPDIR:-/tmp}/media-popup-search.$$"
chanflag="${TMPDIR:-/tmp}/media-popup-channel.$$"
browseflag="${TMPDIR:-/tmp}/media-popup-browse.$$"
rm -f "$flag" "$linkflag" "$searchflag" "$chanflag" "$browseflag"
# Link popup width: the FULL client width (uncapped, unlike the control popup),
# so a long web-UI URL fits on one line — Termux's long-press URL detection (no
# OSC 8) fails on a wrap. Bounded for sanity.
lw="$cw"; [ "$lw" -gt 64 ] && lw=64; [ "$lw" -lt "$MIN" ] && lw="$MIN"
# Open on the channel that's actually playing, else the last-viewed one, else
# speech (`media popup-channel` resolves this). The help round-trip below
# overrides `chan` from the flag file, so an explicit choice is preserved.
chan=$(media popup-channel 2>/dev/null); chan=${chan:-speech}
# Border style comes from the global popup-border-style (active-pane blue, set
# in tmux.conf.local) — no -S override here. The border title is a fixed label:
# tmux expands display-popup -T exactly once (cmd-display-menu.c,
# format_single_from_target) and never on redraw, so a live marquee on the
# border is impossible without -B + the TUI drawing its own border (on the
# radar; `media now-pane --width` already exists for it) — the scrolling
# marquee stays on the TUI's line 1.
popup() { tmux display-popup ${client:+-c "$client"} -E "$@"; }
trim_title() {
    local s="$1" max=54
    s=${s//$'\n'/ }
    s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
    [ -z "$s" ] && s="agent-media"
    if [ "${#s}" -gt "$max" ]; then s="${s:0:$((max - 1))}…"; fi
    printf ' %s ' "$s"
}
popup_title() {
    local t=""
    case "$chan" in
        book)
            t=$(media book meta 2>/dev/null | head -1)
            [ -n "$t" ] && trim_title "☰ $t" || trim_title "☰ book"
            ;;
        music)
            t=$(media music now-status --show-idle --no-bar 2>/dev/null | sed -n '2p')
            [ -n "$t" ] && trim_title "♫ $t" || trim_title "♫ music"
            ;;
        speech|*)
            t=$(TTS_POPUP_PANE=$pane media now-pane --session-only 2>/dev/null | head -1)
            [ -n "$t" ] && trim_title "♪ $t" || trim_title "♪ speech"
            ;;
    esac
}
# Optional: forward a mouse-event debug log path so `prefix a` can calibrate
# click coordinates. Set with `tmux setenv -g MEDIA_POPUP_DEBUG /tmp/popup.log`.
dbg=""; [ -n "${MEDIA_POPUP_DEBUG:-}" ] && dbg="MEDIA_POPUP_DEBUG=$MEDIA_POPUP_DEBUG "
# Anchor the control popup at the BOTTOM-RIGHT (near the input field, like the
# browser canvas's bottom dock, but out of the typing line's way). `-y` is the
# popup's BOTTOM edge (display corner semantics), so place it near the
# client's bottom row.
PH=4
PY=$(( ch - 1 )); [ "$PY" -lt "$PH" ] && PY=$PH
while :; do
    title=$(popup_title)
    popup -w "$w" -h "$PH" -x R -y "$PY" -s 'bg=default' -T "$title" \
        "${dbg}TTS_POPUP_PANE=$pane MEDIA_POPUP_HELP_FLAG=$flag MEDIA_POPUP_LINK_FLAG=$linkflag MEDIA_POPUP_SEARCH_FLAG=$searchflag MEDIA_POPUP_BROWSE_FLAG=$browseflag MEDIA_POPUP_CHANNEL_FLAG=$chanflag MEDIA_POPUP_CHANNEL=$chan media-popup"
    if [ -f "$chanflag" ]; then
        chan=$(cat "$chanflag" 2>/dev/null); chan=${chan:-speech}
        rm -f "$chanflag"
        continue                        # Tab/n changed channel; reopen with new -T
    fi
    if [ -f "$flag" ]; then            # `?` → keymap overlay, then reopen
        chan=$(cat "$flag" 2>/dev/null); chan=${chan:-speech}
        rm -f "$flag"
        popup -w "$hw" -h "$hh" -s 'bg=default' -T ' agent-media help ' media-popup-help
    elif [ -f "$linkflag" ]; then      # `w` → full-width web-UI link, then reopen
        IFS=$'\t' read -r chan url < "$linkflag"; chan=${chan:-speech}
        rm -f "$linkflag"
        popup -w "$lw" -h 5 -s 'bg=default' -T ' web UI ' "MEDIA_POPUP_LINK=$url media-popup-link"
    elif [ -f "$searchflag" ]; then    # `/` → full-size fzf search, then reopen
        chan=$(cat "$searchflag" 2>/dev/null); chan=${chan:-book}
        rm -f "$searchflag"
        sw="$cw"; [ "$sw" -gt 90 ] && sw=90; [ "$sw" -lt "$MIN" ] && sw="$MIN"
        sh="$ch"; [ "$sh" -gt 24 ] && sh=24; [ "$sh" -lt 10 ] && sh="$ch"
        popup -w "$sw" -h "$sh" -s 'bg=default' -T " search $chan " "media-popup-search $chan"
    elif [ -f "$browseflag" ]; then   # `c` → full-size channel browser, then reopen
        chan=$(cat "$browseflag" 2>/dev/null); chan=${chan:-music}
        rm -f "$browseflag"
        sw="$cw"; [ "$sw" -gt 90 ] && sw=90; [ "$sw" -lt "$MIN" ] && sw="$MIN"
        sh="$ch"; [ "$sh" -gt 24 ] && sh=24; [ "$sh" -lt 10 ] && sh="$ch"
        if [ "$chan" = "speech" ]; then
            # TTS_POPUP_PANE: the clip list's "this conversation" anchor
            # falls back to the opening pane's last speaker when idle.
            popup -w "$sw" -h "$sh" -s 'bg=default' -T ' clips ' \
                "TTS_POPUP_PANE=$pane media-popup-clips"
        else
            popup -w "$sw" -h "$sh" -s 'bg=default' -T ' chapters ' media-popup-chapters
        fi
    else
        break                          # normal close → done
    fi
done
rm -f "$flag" "$linkflag" "$searchflag" "$chanflag" "$browseflag"
